---
import PhotoSlot from "@/components/media/PhotoSlot.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Cards to show, three per row. */
  items: { href: string; tag: string; meta: string; title: string }[];
  class?: string;
}

const { render = true, items, class: className } = Astro.props;
---

{render && items.length > 0 && (
  <ul class:list={["related-articles_wrap", className]}>
    {items.map((item) => (
      <li>
        <a class="related-articles_card" href={item.href}>
          <span class="related-articles_photo">
            <PhotoSlot tag="span" alt="" radius="main" />
          </span>
          <span class="related-articles_meta">
            <b>{item.tag}</b>
            <span>{item.meta}</span>
          </span>
          <h3 class="related-articles_title">{item.title}</h3>
        </a>
      </li>
    ))}
  </ul>
)}

<style is:global>
  @layer components {
    .related-articles_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem 1.25rem;
      @media (width < 56.25rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .related-articles_card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      color: var(--text);
      &:hover .related-articles_title {
        text-decoration: underline;
        text-underline-offset: 0.1875rem;
      }
    }

    .related-articles_photo {
      display: block;
      aspect-ratio: 16 / 10;
    }

    .related-articles_meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem 1.125rem;
      font-size: 0.9375rem;
      color: var(--text-3);
      & b {
        font-weight: var(--primary-medium);
        color: var(--text);
      }
    }

    .related-articles_title {
      font-size: 1.1875rem;
      font-weight: var(--primary-semibold);
      line-height: 1.3;
      letter-spacing: 0;
    }
  }
</style>
