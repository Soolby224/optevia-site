---
import Button from "@/components/Button.astro";
import { CONTACT } from "@/consts.ts";

interface Props {
  /** SEO heading, small, above the tagline. */
  title?: string;
  /** Description of the hero photo. */
  photo?: string;
  /** Platforms listed under the hero. */
  platforms?: string[];
}

const {
  title = "Agence de visibilité pour les artisans et entreprises de l’habitat",
  photo = "Un artisan sur un chantier, plan large, lumière naturelle",
  platforms = ["Google", "Google Maps", "ChatGPT", "Gemini", "Perplexity", "Bing"],
} = Astro.props;
---

<div class="hero-home_wrap">
  <div class="hero-home_frame">
    <div class="hero-home_photo" role="img" aria-label={`Photo : ${photo}`}>
      <span>[Photo : {photo}]</span>
    </div>
    <div class="hero-home_card">
      <div class="hero-home_titles">
        <h1 id="hero-home-title" class="hero-home_seo">{title}</h1>
        <p class="hero-home_tagline">
          Votre savoir‑faire<br /><span>mérite d’être vu.</span>
        </p>
      </div>
      <div class="hero-home_body">
        <p class="hero-home_text">
          Optevia aide les artisans à être trouvés sur Google, sur Google Maps
          et dans les réponses des IA comme ChatGPT. Site internet, fiche Google
          et automatisations, sans engagement longue durée.
        </p>
        <div class="hero-home_actions">
          <Button element="link" href="/#audit" arrow>Audit gratuit</Button>
          <Button
            element="link"
            href={CONTACT.whatsapp}
            emphasis="secondary"
            arrow
            rel="noopener"
          >
            Écrire sur WhatsApp
          </Button>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-home_platforms">
    <p class="hero-home_platforms_title">
      On vous rend visible là où vos clients cherchent
    </p>
    <ul class="hero-home_platforms_list">
      {platforms.map((name) => <li>{name}</li>)}
    </ul>
  </div>
</div>

<style is:global>
  @layer components {
    .hero-home_wrap {
      width: 100%;
    }

    .hero-home_frame {
      position: relative;
    }

    .hero-home_photo {
      height: clamp(35rem, 74vh, 47.5rem);
      display: flex;
      align-items: flex-start;
      justify-content: flex-end;
      padding: 1.75rem clamp(1rem, 4vw, 3rem);
      border-radius: var(--radius-large);
      background-color: var(--light-300);
      font-size: 0.8125rem;
      color: var(--dark-500);
      @media (width < 47.5rem) {
        height: 44vh;
        min-height: 18.75rem;
      }
    }

    .hero-home_card {
      position: absolute;
      left: clamp(1rem, 2.4vw, 2rem);
      right: clamp(4.5rem, 8vw, 7.5rem);
      bottom: clamp(1rem, 2.4vw, 2rem);
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 3rem);
      align-items: center;
      padding: clamp(1.5rem, 3vw, 2.5rem);
      border-radius: var(--radius-main);
      background-color: var(--light-100);
      box-shadow: 0 1.5rem 3rem -2rem rgb(17 17 17 / 0.35);
      @media (width < 60rem) {
        right: clamp(1rem, 2.4vw, 2rem);
        grid-template-columns: minmax(0, 1fr);
      }
      @media (width < 47.5rem) {
        position: relative;
        inset: auto;
        margin: -3rem 0.75rem 0;
      }
    }

    .hero-home_titles,
    .hero-home_body {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .hero-home_seo {
      font-size: 0.9375rem;
      font-weight: var(--primary-medium);
      line-height: 1.4;
      letter-spacing: 0;
      text-box: none;
    }

    .hero-home_tagline {
      font-size: clamp(2.375rem, 4.4vw, 4rem);
      font-weight: var(--primary-medium);
      line-height: 1.02;
      letter-spacing: -0.038em;
      & span {
        color: var(--coral-500);
      }
    }

    .hero-home_text {
      font-size: 1rem;
      line-height: 1.55;
      color: var(--text-2);
    }

    .hero-home_actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      @media (width < 45rem) {
        width: 100%;
        & > * {
          width: 100%;
        }
      }
    }

    .hero-home_platforms {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.375rem;
      padding-block: clamp(2rem, 4vw, 3rem);
      text-align: center;
    }

    .hero-home_platforms_title {
      font-size: 0.875rem;
      font-weight: var(--primary-medium);
      color: var(--text-2);
    }

    .hero-home_platforms_list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.875rem clamp(1.75rem, 5vw, 4rem);
      & li {
        font-weight: var(--primary-semibold);
        font-size: clamp(1.125rem, 1.8vw, 1.5rem);
        letter-spacing: -0.025em;
        color: var(--coral-500);
      }
    }
  }
</style>
