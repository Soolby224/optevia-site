---
import Icon from "@/components/media/Icon.astro";
import arrowRight from "@/assets/icons/ion/arrow-forward-outline.svg";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Page of the other service. */
  href: string;
  /** Text under the heading. */
  text: string;
  /** Price, such as `150 €`. */
  price: string;
  /** Small text before the price. */
  pricePrefix?: string;
  /** Small text after the price. */
  priceSuffix?: string;
  /** Link label. */
  cta: string;
  /** Id of the heading, referenced by the section's `aria-labelledby`. */
  id?: string;
  class?: string;
}

const {
  render = true,
  href,
  text,
  price,
  pricePrefix,
  priceSuffix,
  cta,
  id = "other-service-title",
  class: className,
} = Astro.props;
---

{render && (
  <a class:list={["other-service_wrap", className]} href={href}>
    <div class="other-service_content">
      <p class="other-service_eyebrow">L’autre service</p>
      <h2 id={id} class="other-service_title text-style-h2 heading-accent"><slot /></h2>
      <p class="other-service_text">{text}</p>
    </div>
    <div class="other-service_side">
      <p class="other-service_price">
        {pricePrefix && <span>{pricePrefix}</span>}
        {price}
        {priceSuffix && <small>{priceSuffix}</small>}
      </p>
      <span class="other-service_cta">
        {cta}
        <Icon src={arrowRight} variant="small" />
      </span>
    </div>
  </a>
)}

<style is:global>
  @layer components {
    .other-service_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 2rem clamp(2rem, 5vw, 5rem);
      align-items: end;
      padding: clamp(1.75rem, 4vw, 3.5rem);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
      background-color: var(--light-200);
      color: var(--dark-900);
      transition: border-color var(--hover-duration) var(--hover-ease);
      &:hover {
        border-color: var(--dark-900);
        & .other-service_cta svg {
          transform: translateX(0.25rem);
        }
      }
      @media (width < 56.25rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .other-service_content,
    .other-service_side {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .other-service_eyebrow {
      font-size: 0.875rem;
      font-weight: var(--primary-medium);
      color: var(--text-3);
    }

    .other-service_text {
      max-width: 33.75rem;
      font-size: 1.0625rem;
      line-height: 1.6;
      color: var(--text-2);
    }

    .other-service_price {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      font-size: clamp(2.75rem, 5vw, 4.5rem);
      font-weight: var(--primary-semibold);
      line-height: 1;
      letter-spacing: -0.045em;
      & span,
      & small {
        font-size: 1rem;
        font-weight: var(--primary-medium);
        letter-spacing: 0;
        color: var(--text-3);
      }
    }

    .other-service_cta {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      min-height: 2.75rem;
      font-weight: var(--primary-semibold);
      text-decoration: underline;
      text-decoration-color: var(--brand-500);
      text-decoration-thickness: 0.125rem;
      text-underline-offset: 0.3125rem;
      & svg {
        transition: transform var(--hover-duration) var(--hover-ease);
      }
    }
  }
</style>
