---
import Heading from "@/components/typography/Heading.astro";

type Step = { when: string; title: string; text: string; ongoing?: boolean };

const defaultSteps: Step[] = [
  { when: "Jour 1", title: "Appel de lancement", text: "On fait le point ensemble : votre métier, vos zones, vos photos et l’accès à votre fiche Google." },
  { when: "Jours 2 et 3", title: "Stratégie", text: "On étudie vos concurrents dans votre ville et ce qui les fait sortir en premier, pour faire mieux." },
  { when: "Jours 4 à 6", title: "Maquette", text: "On vous envoie la page d’accueil. Vous validez ou demandez des retouches, sur WhatsApp." },
  { when: "Jours 7 à 11", title: "Construction", text: "Toutes les pages, les textes écrits pour vous, le formulaire de devis et votre fiche Google." },
  { when: "Jour 12", title: "Mise en ligne", text: "Votre site est en ligne avec votre nom de domaine. On vous montre comment recevoir vos demandes." },
  { when: "Ensuite, chaque mois", title: "Accompagnement", text: "Fiche Google suivie, compte rendu mensuel, outil Gagner du temps ajusté. Joignables sur WhatsApp.", ongoing: true },
];

interface Props {
  /** Id of the heading, referenced by the section's `aria-labelledby`. */
  id?: string;
  /** Text beside the heading. */
  lead?: string;
  /** Steps of the timeline. Defaults to the site launch. */
  steps?: Step[];
}

const {
  id = "steps-home-title",
  lead = "De la signature à la mise en ligne, voici ce qui se passe. Et après, on ne vous lâche pas.",
  steps = defaultSteps,
} = Astro.props;

---

<div class="steps-home_wrap">
  <div class="steps-home_head">
    <Heading id={id} class="heading-accent">
      <slot>Votre site en ligne<br /><strong>en moins de 2 semaines.</strong></slot>
    </Heading>
    <p class="steps-home_lead">{lead}</p>
  </div>

  <ol class="steps-home_list" style={`--_count: ${steps.length};`}>
    {steps.map((step) => (
      <li class:list={["steps-home_item", step.ongoing && "is-ongoing"]}>
        <span class="steps-home_dot" aria-hidden="true" />
        <p class="steps-home_when">{step.when}</p>
        <h3 class="steps-home_title">{step.title}</h3>
        <p class="steps-home_text">{step.text}</p>
      </li>
    ))}
  </ol>
  <slot name="cta" />
</div>

<style is:global>
  @layer components {
    .steps-home_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: clamp(3rem, 6vw, 5rem);
    }

    .steps-home_head {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1.5rem 3rem;
    }

    .steps-home_lead {
      max-width: 25rem;
      font-size: 1.0625rem;
      line-height: 1.6;
      color: var(--text-2);
    }

    .steps-home_list {
      position: relative;
      display: grid;
      grid-template-columns: repeat(var(--_count, 6), minmax(0, 1fr));
      gap: 1.25rem;
      &::before {
        content: "";
        position: absolute;
        inset: 0.5625rem 0 auto;
        height: 0.09375rem;
        background-color: var(--border);
      }
      @media (width < 68.75rem) {
        grid-template-columns: repeat(min(3, var(--_count, 6)), minmax(0, 1fr));
        row-gap: 2.5rem;
        &::before {
          display: none;
        }
      }
      @media (width < 60rem) {
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
        &::before {
          display: block;
          inset: 0 auto 0 0.5625rem;
          width: 0.09375rem;
          height: auto;
        }
      }
    }

    .steps-home_item {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      padding-top: 2.5rem;
      @media (width < 60rem) {
        padding: 0 0 2rem 2.75rem;
      }
    }

    .steps-home_dot {
      position: absolute;
      top: 0;
      left: 0;
      width: 1.25rem;
      height: 1.25rem;
      border-radius: 50%;
      background-color: var(--brand-500);
      box-shadow: 0 0 0 0.375rem var(--background);
      @media (width < 60rem) {
        top: 0.125rem;
      }
    }

    .is-ongoing .steps-home_dot {
      background-color: var(--background);
      box-shadow:
        0 0 0 0.375rem var(--background),
        inset 0 0 0 0.125rem var(--brand-500);
    }

    .steps-home_when {
      font-weight: var(--primary-semibold);
      font-size: 0.9375rem;
      color: var(--brand-500);
    }

    .steps-home_title {
      font-size: clamp(1.25rem, 1.6vw, 1.4375rem);
      letter-spacing: -0.02em;
      line-height: 1.15;
      color: var(--light-100);
    }

    .steps-home_text {
      font-size: 0.9375rem;
      line-height: 1.55;
      color: var(--text-2);
    }
  }
</style>
