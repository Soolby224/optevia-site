---
import Heading from "@/components/typography/Heading.astro";
import Icon from "@/components/media/Icon.astro";
import arrowRight from "@/assets/icons/arrow-right.svg";

const choices = [
  { situation: "Vous n’avez pas de site, ou il date.", answer: "Site internet", href: "#site" },
  { situation: "Vous avez un site, mais personne ne vous trouve.", answer: "Visibilité", href: "#visibilite" },
  { situation: "Le téléphone sonne, mais vous ratez des appels et des devis.", answer: "Gagner du temps", href: "#gagner-du-temps" },
  { situation: "Vous voulez être trouvé et ne plus rien rater.", answer: "Le pack", href: "#pack" },
];
---

<div class="choice-tarifs_wrap">
  <Heading id="choice-tarifs-title" class="heading-accent">
    Par où<br /><strong>commencer ?</strong>
  </Heading>
  <div class="choice-tarifs_list">
    {choices.map((choice) => (
      <a class="choice-tarifs_item" href={choice.href}>
        <span class="choice-tarifs_situation">{choice.situation}</span>
        <span class="choice-tarifs_answer">
          {choice.answer}
          <Icon src={arrowRight} variant="small" />
        </span>
      </a>
    ))}
  </div>
</div>

<style is:global>
  @layer components {
    .choice-tarifs_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
      @media (width < 56.25rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .choice-tarifs_list {
      display: flex;
      flex-direction: column;
      border-top: var(--border-width) solid var(--border);
    }

    .choice-tarifs_item {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem 1.5rem;
      align-items: center;
      min-height: 4.75rem;
      padding: 1rem 0;
      border-bottom: var(--border-width) solid var(--border);
      color: var(--text);
      &:hover .choice-tarifs_answer {
        background-color: var(--brand-500);
        & svg {
          transform: translateX(0.25rem);
        }
      }
      @media (width < 37.5rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .choice-tarifs_situation {
      font-size: 1.125rem;
      line-height: 1.4;
    }

    .choice-tarifs_answer {
      justify-self: start;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 0.875rem;
      border-radius: var(--radius-button);
      background-color: var(--light-200);
      font-size: 1.0625rem;
      font-weight: var(--primary-semibold);
      transition: background-color var(--hover-duration) var(--hover-ease);
      & svg {
        transition: transform var(--hover-duration) var(--hover-ease);
      }
    }
  }
</style>
