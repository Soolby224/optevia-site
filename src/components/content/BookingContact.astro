---
import Breadcrumb from "@/components/global/Breadcrumb.astro";
import PhotoSlot from "@/components/media/PhotoSlot.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import checkmark from "@/assets/icons/ion/checkmark-outline.svg";

const steps = [
  "Vous réservez un créneau.",
  "On écoute, on regarde votre visibilité sur Google et dans les IA.",
  "On vous envoie un plan clair, avec les prix. Vous décidez.",
];

const trust = ["Prix affichés", "Sans engagement", "Votre site vous appartient"];

const weekdays = ["LUN", "MAR", "MER", "JEU", "VEN", "SAM", "DIM"];
---

<div class="booking-contact_wrap">
  <div class="booking-contact_intro">
    <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "Contact" }]} />
    <h1 id="booking-contact-title" class="booking-contact_seo">
      Contact Optevia : réservez un appel de 20 minutes
    </h1>
    <p class="booking-contact_tagline">Parlons-en.</p>
    <p class="booking-contact_lead">
      20 minutes pour comprendre votre entreprise, vos clients et ce qui vous
      manque pour être choisi. Sans jargon, sans engagement.
    </p>
    <ol class="booking-contact_steps">
      {steps.map((step, index) => (
        <li><b>{index + 1}.</b> {step}</li>
      ))}
    </ol>
    <ul class="booking-contact_trust">
      {trust.map((item) => <li><Icon src={checkmark} variant="small" />{item}</li>)}
    </ul>
  </div>

  <div class="booking-contact_stage">
    <div class="booking-contact_photo">
      <PhotoSlot alt="Un artisan sur un chantier, lumière naturelle" radius="large" eager />
    </div>

    {/* TODO : brancher Cal.com (ou un service de formulaire). Les créneaux sont des exemples et rien n’est envoyé. */}
    <div class="booking-contact_card" data-booking aria-live="polite">
      <div class="booking-contact_pick" data-step="1">
        <div class="booking-contact_calendar">
          <div class="booking-contact_avatar">
            <PhotoSlot alt="Portrait du fondateur" />
          </div>
          <p class="booking-contact_who">Rencontrez Thierno Touré,<br />fondateur d’Optevia</p>
          <div class="booking-contact_month">
            <button type="button" class="booking-contact_nav" data-month="-1" aria-label="Mois précédent">‹</button>
            <b data-month-label></b>
            <button type="button" class="booking-contact_nav" data-month="1" aria-label="Mois suivant">›</button>
          </div>
          <div class="booking-contact_week" aria-hidden="true">
            {weekdays.map((day) => <span>{day}</span>)}
          </div>
          <div class="booking-contact_days" role="group" aria-label="Jours disponibles" data-days></div>
        </div>

        <div class="booking-contact_options">
          <p class="booking-contact_key">Lieu du rendez-vous</p>
          <div class="booking-contact_channels">
            <button type="button" class="booking-contact_channel" data-channel="wa" aria-pressed="true">WhatsApp</button>
            <button type="button" class="booking-contact_channel" data-channel="meet" aria-pressed="false">Google Meet</button>
          </div>
          <p class="booking-contact_key">Durée</p>
          <p class="booking-contact_duration">20 min</p>
          <p class="booking-contact_key">Quelle heure vous convient ?</p>
          <p class="booking-contact_for">Créneaux du <b data-day-label></b> · heure de Paris</p>
          <div class="booking-contact_times" data-times></div>
        </div>
      </div>

      <form class="booking-contact_form" data-step="2" hidden>
        <div class="booking-contact_form_body">
          <p class="booking-contact_form_title">Vos informations</p>
          <p class="booking-contact_summary">
            <b data-summary></b>
            <button type="button" class="booking-contact_edit" data-back>Modifier</button>
          </p>
          <p class="booking-contact_place" data-channel-label></p>
          <div class="booking-contact_fields">
            <div class="booking-contact_field">
              <label for="booking-first">Prénom *</label>
              <input id="booking-first" name="prenom" type="text" autocomplete="given-name" required />
            </div>
            <div class="booking-contact_field">
              <label for="booking-last">Nom *</label>
              <input id="booking-last" name="nom" type="text" autocomplete="family-name" required />
            </div>
            <div class="booking-contact_field is-wide">
              <label for="booking-mail">E-mail *</label>
              <input id="booking-mail" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="booking-contact_field">
              <label for="booking-phone">Téléphone *</label>
              <input id="booking-phone" name="telephone" type="tel" autocomplete="tel" required />
            </div>
            <div class="booking-contact_field">
              <label for="booking-trade">Métier et ville *</label>
              <input id="booking-trade" name="metier" type="text" placeholder="Ex. : plombier à [Ville]" required />
            </div>
            <div class="booking-contact_field is-wide">
              <label for="booking-site">Votre site internet <span>(facultatif)</span></label>
              <input id="booking-site" name="site" type="url" placeholder="https://" />
            </div>
            <div class="booking-contact_field is-wide">
              <label for="booking-why">De quoi voulez-vous parler ? *</label>
              <textarea id="booking-why" name="sujet" rows="3" placeholder="Ex. : je veux plus de demandes de devis en rénovation" required></textarea>
            </div>
          </div>
          <div class="booking-contact_privacy">
            <b>Vos données</b>
            <p>
              Elles servent uniquement à préparer notre appel et à vous
              recontacter. Pas de revente.
              <a href="/confidentialite">Politique de confidentialité</a>
            </p>
          </div>
        </div>
        <div class="booking-contact_bar">
          <button type="button" class="booking-contact_back" data-back>‹ Retour</button>
          <Button type="submit" arrow>Confirmer</Button>
        </div>
      </form>

      <div class="booking-contact_done" data-step="3" hidden>
        <p class="booking-contact_done_title">C’est réservé.</p>
        <p><b data-summary></b><br /><span data-channel-label></span></p>
        <p class="booking-contact_small">
          Vous recevez la confirmation par e-mail, et un rappel la veille.
        </p>
        <button type="button" class="booking-contact_back" data-reset>Réserver un autre créneau</button>
      </div>
    </div>
  </div>
</div>

<script>
  const SLOTS = [
    ["09:00", "09:30", "11:00", "14:30", "16:00", "17:30"],
    ["10:00", "11:30", "14:00", "16:30"],
    ["09:00", "10:30", "12:00", "15:00", "17:00"],
    ["09:30", "11:00", "14:00", "15:30", "16:30"],
    ["10:00", "10:30", "11:30", "14:00", "15:30", "17:00"],
  ];
  const CHANNELS: Record<string, string> = {
    wa: "Appel WhatsApp (audio ou vidéo)",
    meet: "Visio Google Meet (lien envoyé par e-mail)",
  };
  const MAX_MONTHS = 2;

  const capitalize = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
  const dayLabel = (date: Date, withYear: boolean) =>
    capitalize(
      date.toLocaleDateString("fr-FR", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: withYear ? "numeric" : undefined,
      }),
    );

  document.querySelectorAll<HTMLElement>("[data-booking]").forEach((root) => {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const isOpen = (date: Date) => date > today && date.getDay() >= 1 && date.getDay() <= 5;
    const slotsFor = (date: Date) => (isOpen(date) ? SLOTS[date.getDay() - 1] : []);

    const firstOpen = new Date(today);
    do firstOpen.setDate(firstOpen.getDate() + 1);
    while (!isOpen(firstOpen));

    const state = { day: firstOpen, time: "", channel: "wa", offset: 0 };
    state.offset =
      (firstOpen.getFullYear() - today.getFullYear()) * 12 + firstOpen.getMonth() - today.getMonth();

    const daysEl = root.querySelector<HTMLElement>("[data-days]")!;
    const timesEl = root.querySelector<HTMLElement>("[data-times]")!;
    const monthLabel = root.querySelector<HTMLElement>("[data-month-label]")!;
    const form = root.querySelector<HTMLFormElement>("form")!;

    const setText = (selector: string, text: string) =>
      root.querySelectorAll<HTMLElement>(selector).forEach((el) => (el.textContent = text));

    const showStep = (step: number) => {
      root.querySelectorAll<HTMLElement>("[data-step]").forEach((el) => {
        el.hidden = Number(el.dataset.step) !== step;
      });
    };

    const render = () => {
      const month = new Date(today.getFullYear(), today.getMonth() + state.offset, 1);
      monthLabel.textContent = capitalize(
        month.toLocaleDateString("fr-FR", { month: "long", year: "numeric" }),
      );
      root.querySelector<HTMLButtonElement>('[data-month="-1"]')!.disabled = state.offset <= 0;
      root.querySelector<HTMLButtonElement>('[data-month="1"]')!.disabled = state.offset >= MAX_MONTHS;

      daysEl.replaceChildren();
      const lead = (month.getDay() + 6) % 7;
      for (let i = 0; i < lead; i++) daysEl.append(document.createElement("span"));
      const count = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
      for (let n = 1; n <= count; n++) {
        const date = new Date(month.getFullYear(), month.getMonth(), n);
        const open = isOpen(date);
        const selected = date.getTime() === state.day.getTime();
        const button = document.createElement("button");
        button.type = "button";
        button.className = "booking-contact_day";
        button.textContent = String(n);
        button.disabled = !open;
        button.setAttribute("aria-pressed", String(selected));
        button.setAttribute("aria-label", dayLabel(date, false) + (open ? "" : ", indisponible"));
        if (open) {
          button.addEventListener("click", () => {
            state.day = date;
            render();
          });
        }
        daysEl.append(button);
      }

      setText("[data-day-label]", dayLabel(state.day, false));
      timesEl.replaceChildren(
        ...slotsFor(state.day).map((time) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "booking-contact_time";
          button.textContent = time;
          button.addEventListener("click", () => {
            state.time = time;
            setText("[data-summary]", `${dayLabel(state.day, true)} à ${time.replace(":", " h ")}`);
            showStep(2);
          });
          return button;
        }),
      );

      root.querySelectorAll<HTMLButtonElement>("[data-channel]").forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.channel === state.channel));
      });
      setText("[data-channel-label]", CHANNELS[state.channel]);
    };

    root.querySelectorAll<HTMLButtonElement>("[data-month]").forEach((button) => {
      button.addEventListener("click", () => {
        state.offset = Math.min(MAX_MONTHS, Math.max(0, state.offset + Number(button.dataset.month)));
        render();
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-channel]").forEach((button) => {
      button.addEventListener("click", () => {
        state.channel = button.dataset.channel ?? "wa";
        render();
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-back]").forEach((button) => {
      button.addEventListener("click", () => showStep(1));
    });

    root.querySelector<HTMLButtonElement>("[data-reset]")!.addEventListener("click", () => {
      state.time = "";
      form.reset();
      showStep(1);
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      // TODO : envoyer la réservation (Cal.com ou service de formulaire) avant d’afficher la confirmation.
      showStep(3);
    });

    render();
  });
</script>

<style is:global>
  @layer components {
    .booking-contact_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
      @media (width < 68.75rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .booking-contact_intro {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .booking-contact_seo {
      font-size: 0.9375rem;
      font-weight: var(--primary-medium);
      line-height: 1.4;
      letter-spacing: 0;
      color: var(--text-3);
      text-box: none;
    }

    .booking-contact_tagline {
      font-size: clamp(3rem, 7vw, 6rem);
      font-weight: var(--primary-semibold);
      line-height: 0.95;
      letter-spacing: -0.045em;
    }

    .booking-contact_lead {
      max-width: 30rem;
      font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
      line-height: 1.55;
      color: var(--text-2);
    }

    .booking-contact_steps {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 30rem;
      border-top: var(--border-width) solid var(--border);
      & li {
        padding: 0.875rem 0;
        border-bottom: var(--border-width) solid var(--border);
        font-size: 1.0625rem;
        line-height: 1.45;
      }
      & b {
        margin-right: 0.375rem;
        font-weight: var(--primary-semibold);
        color: var(--coral-500);
      }
    }

    .booking-contact_trust {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      font-size: 0.9375rem;
      font-weight: var(--primary-medium);
      & li {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
      }
      & svg {
        color: var(--coral-500);
      }
    }

    .booking-contact_stage {
      position: relative;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      min-height: 50rem;
      padding: clamp(1rem, 3vw, 2.5rem);
      @media (width < 68.75rem) {
        min-height: 0;
      }
      @media (width < 37.5rem) {
        padding: 0;
      }
    }

    .booking-contact_photo {
      position: absolute;
      inset: 0;
      @media (width < 37.5rem) {
        display: none;
      }
    }

    .booking-contact_card {
      position: relative;
      width: 100%;
      max-width: 51.25rem;
      min-height: 40rem;
      margin-top: 1.25rem;
      overflow: hidden;
      border-radius: var(--radius-large);
      background-color: var(--light-100);
      box-shadow: 0 2.5rem 5rem -3.125rem rgb(17 17 17 / 0.55);
      @media (width < 37.5rem) {
        margin-top: 0;
        min-height: 0;
        border: var(--border-width) solid var(--border);
        box-shadow: none;
      }
    }

    .booking-contact_pick {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: inherit;
      &[hidden] {
        display: none;
      }
      @media (width < 45rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .booking-contact_calendar,
    .booking-contact_options {
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
      padding: clamp(1.25rem, 2.6vw, 2rem);
    }

    .booking-contact_options {
      background-color: var(--light-200);
    }

    .booking-contact_avatar {
      width: 4rem;
      height: 4rem;
      overflow: hidden;
      border-radius: 50%;
    }

    .booking-contact_who {
      font-size: 1.25rem;
      font-weight: var(--primary-semibold);
      line-height: 1.2;
      letter-spacing: -0.02em;
    }

    .booking-contact_month {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 0.5rem;
      font-size: 1rem;
    }

    .booking-contact_nav {
      width: 2.75rem;
      height: 2.75rem;
      border-radius: var(--radius-button);
      font-size: 1.25rem;
      transition: background-color var(--hover-duration) var(--hover-ease);
      &:hover:not(:disabled) {
        background-color: var(--light-200);
      }
      &:disabled {
        opacity: 0.3;
        cursor: default;
      }
    }

    .booking-contact_week,
    .booking-contact_days {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 0.25rem;
      text-align: center;
    }

    .booking-contact_week {
      font-size: 0.6875rem;
      font-weight: var(--primary-semibold);
      color: var(--text-3);
    }

    .booking-contact_day {
      aspect-ratio: 1;
      min-height: 2.25rem;
      border-radius: var(--radius-button);
      font-size: 0.9375rem;
      font-weight: var(--primary-medium);
      font-variant-numeric: tabular-nums;
      background-color: var(--light-200);
      transition: background-color var(--hover-duration) var(--hover-ease);
      &:hover:not(:disabled) {
        background-color: var(--light-300);
      }
      &:disabled {
        background-color: transparent;
        color: var(--text-3);
        opacity: 0.5;
        cursor: default;
      }
      &[aria-pressed="true"] {
        background-color: var(--dark-900);
        color: var(--light-100);
      }
    }

    .booking-contact_key {
      margin-top: 0.5rem;
      font-size: 0.8125rem;
      font-weight: var(--primary-semibold);
      color: var(--text-3);
    }

    .booking-contact_channels {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .booking-contact_channel,
    .booking-contact_time {
      min-height: 2.75rem;
      padding: 0.5rem 0.75rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-button);
      background-color: var(--light-100);
      font-size: 0.9375rem;
      font-weight: var(--primary-semibold);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      &:hover {
        border-color: var(--dark-900);
      }
      &[aria-pressed="true"] {
        border-color: var(--dark-900);
        background-color: var(--dark-900);
        color: var(--light-100);
      }
    }

    .booking-contact_time:hover {
      background-color: var(--brand-500);
      border-color: var(--brand-500);
    }

    .booking-contact_duration {
      font-size: 1.0625rem;
      font-weight: var(--primary-semibold);
    }

    .booking-contact_for {
      font-size: 0.875rem;
      color: var(--text-2);
    }

    .booking-contact_times {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .booking-contact_form {
      display: flex;
      flex-direction: column;
      min-height: inherit;
      &[hidden] {
        display: none;
      }
    }

    .booking-contact_form_body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
      padding: clamp(1.25rem, 2.6vw, 2rem);
    }

    .booking-contact_form_title {
      font-size: 1.5rem;
      font-weight: var(--primary-semibold);
      letter-spacing: -0.025em;
    }

    .booking-contact_summary {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.25rem 0.75rem;
      font-size: 1.0625rem;
    }

    .booking-contact_edit,
    .booking-contact_back {
      min-height: 2.75rem;
      font-size: 0.9375rem;
      font-weight: var(--primary-semibold);
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .booking-contact_place {
      font-size: 0.9375rem;
      color: var(--text-2);
    }

    .booking-contact_fields {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.875rem;
      @media (width < 37.5rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .booking-contact_field {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      &.is-wide {
        grid-column: 1 / -1;
      }
      & label {
        font-size: 0.875rem;
        font-weight: var(--primary-semibold);
        & span {
          font-weight: var(--primary-regular);
          color: var(--text-3);
        }
      }
      & input,
      & textarea {
        width: 100%;
        min-height: 2.75rem;
        padding: 0.625rem 0.75rem;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-button);
        background-color: var(--light-100);
        font: inherit;
        font-size: 1rem;
        color: var(--text);
        &:focus-visible {
          border-color: var(--dark-900);
        }
      }
      & textarea {
        resize: vertical;
      }
    }

    .booking-contact_privacy {
      padding: 0.875rem 1rem;
      border-radius: var(--radius-small);
      background-color: var(--light-200);
      font-size: 0.875rem;
      line-height: 1.5;
      color: var(--text-2);
      & b {
        color: var(--text);
      }
      & a {
        text-decoration: underline;
      }
    }

    .booking-contact_bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1rem clamp(1.25rem, 2.6vw, 2rem);
      border-top: var(--border-width) solid var(--border);
    }

    .booking-contact_done {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 1rem;
      min-height: inherit;
      padding: clamp(1.5rem, 4vw, 3.5rem);
      font-size: 1.0625rem;
      line-height: 1.5;
      &[hidden] {
        display: none;
      }
    }

    .booking-contact_done_title {
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: var(--primary-semibold);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .booking-contact_small {
      font-size: 0.9375rem;
      color: var(--text-2);
    }
  }
</style>
