---
import type { GuideChapter } from "@/data/guides.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Chapters of the guide, in order. */
  chapters: GuideChapter[];
  class?: string;
}

const { render = true, chapters, class: className } = Astro.props;
---

{render && chapters.length > 0 && (
  <div class:list={["body-guide_wrap", className]}>
    <nav class="body-guide_toc" aria-label="Chapitres">
      <ol>
        {chapters.map((chapter, index) => (
          <li>
            <a href={`#${chapter.id}`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              {chapter.title}
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="body-guide_text">
      {chapters.map((chapter, index) => (
        <section id={chapter.id} class="body-guide_chapter">
          <p class="body-guide_number">Chapitre {index + 1}</p>
          <h2>{chapter.title}</h2>
          <p>{chapter.text}</p>
          {chapter.checks && (
            <ul class="body-guide_checks">
              {chapter.checks.map((check) => <li>{check}</li>)}
            </ul>
          )}
          {chapter.action && (
            <aside class="body-guide_action">
              <b>À faire cette semaine</b> {chapter.action}
            </aside>
          )}
        </section>
      ))}
    </div>
  </div>
)}

<style is:global>
  @layer components {
    .body-guide_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: 16.25rem minmax(0, 43.75rem);
      justify-content: center;
      gap: 2.5rem clamp(2.5rem, 6vw, 6rem);
      padding-top: clamp(2.5rem, 5vw, 4rem);
      border-top: var(--border-width) solid var(--border);
      @media (width < 60rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .body-guide_toc {
      position: sticky;
      top: calc(var(--nav-height) + 2rem);
      align-self: start;
      @media (width < 60rem) {
        position: static;
      }
      & a {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        min-height: 3rem;
        border-bottom: var(--border-width) solid var(--border);
        font-weight: var(--primary-medium);
        color: var(--text);
        transition: color var(--hover-duration) var(--hover-ease);
        &:hover {
          color: var(--coral-500);
        }
      }
      & span {
        font-size: 0.875rem;
        color: var(--text-3);
        font-variant-numeric: tabular-nums;
      }
    }

    .body-guide_text {
      font-size: 1.125rem;
      line-height: 1.7;
    }

    .body-guide_chapter {
      padding-bottom: 3rem;
      margin-bottom: 3rem;
      border-bottom: var(--border-width) solid var(--border);
      scroll-margin-top: calc(var(--nav-height) + 2rem);
      &:last-child {
        padding-bottom: 0;
        margin-bottom: 0;
        border-bottom: 0;
      }
      & h2 {
        margin-bottom: 0.875rem;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: var(--primary-semibold);
        line-height: 1.05;
        letter-spacing: -0.03em;
      }
    }

    .body-guide_number {
      margin-bottom: 0.375rem;
      font-size: 0.875rem;
      color: var(--text-3);
    }

    .body-guide_checks {
      margin-top: 1.25rem;
      border-top: var(--border-width) solid var(--border);
      & li {
        position: relative;
        padding: 0.8125rem 0 0.8125rem 2.125rem;
        border-bottom: var(--border-width) solid var(--border);
        font-size: 1.0625rem;
        line-height: 1.45;
        &::before {
          content: "";
          position: absolute;
          left: 0;
          top: 0.9375rem;
          width: 1.125rem;
          height: 1.125rem;
          border-radius: 0.25rem;
          box-shadow: inset 0 0 0 0.09375rem var(--text);
        }
      }
    }

    .body-guide_action {
      margin-top: 1.5rem;
      padding: 1.125rem 1.375rem;
      border-left: 0.1875rem solid var(--brand-500);
      border-radius: 0 var(--radius-small) var(--radius-small) 0;
      background-color: var(--background-2);
      font-size: 1rem;
      line-height: 1.5;
      & b {
        display: block;
        margin-bottom: 0.25rem;
      }
    }
  }
</style>
