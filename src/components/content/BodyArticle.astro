---
import Icon from "@/components/media/Icon.astro";
import arrowForward from "@/assets/icons/ion/arrow-forward-outline.svg";
import type { ArticleSection } from "@/data/articles.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Body of the article, one titled section per entry. */
  sections: ArticleSection[];
  /** Key points shown before the body. */
  summary?: string[];
  class?: string;
}

const { render = true, sections, summary = [], class: className } = Astro.props;

const toc = [
  ...(summary.length > 0 ? [{ id: "bref", title: "En bref" }] : []),
  ...sections.map(({ id, title }) => ({ id, title })),
];
---

{render && sections.length > 0 && (
  <div class:list={["body-article_wrap", className]}>
    <nav class="body-article_toc" aria-label="Sommaire">
      <p>Sommaire</p>
      <ol>
        {toc.map((item) => <li><a href={`#${item.id}`}>{item.title}</a></li>)}
      </ol>
    </nav>
    <div class="body-article_text">
      {summary.length > 0 && (
        <section id="bref" class="body-article_summary" aria-label="En bref">
          <p>En bref</p>
          <ul>{summary.map((point) => <li>{point}</li>)}</ul>
        </section>
      )}
      {sections.map((section) => (
        <Fragment>
          <h2 id={section.id}>{section.title}</h2>
          {section.blocks.map((block) => {
            if (block.type === "ul") return <ul>{block.items.map((item) => <li>{item}</li>)}</ul>;
            if (block.type === "quote") return <blockquote>{block.text}</blockquote>;
            return <p>{block.text}</p>;
          })}
        </Fragment>
      ))}
      <aside class="body-article_cta">
        <p>
          <b>Envie de savoir où vous en êtes ?</b> L’audit gratuit mesure aussi votre visibilité dans les IA.
        </p>
        <a href="/contact">
          Demander mon audit
          <Icon src={arrowForward} variant="small" />
        </a>
      </aside>
    </div>
  </div>
)}

<style is:global>
  @layer components {
    .body-article_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: 13.75rem minmax(0, 42.5rem);
      justify-content: center;
      gap: 2.5rem clamp(2.5rem, 6vw, 6rem);
      @media (width < 56.25rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .body-article_toc {
      position: sticky;
      top: calc(var(--nav-height) + 2rem);
      align-self: start;
      @media (width < 56.25rem) {
        position: static;
      }
      & p {
        margin-bottom: 0.625rem;
        font-size: 0.875rem;
        color: var(--text-3);
      }
      & ol {
        border-top: var(--border-width) solid var(--border);
      }
      & a {
        display: flex;
        align-items: center;
        min-height: 2.75rem;
        border-bottom: var(--border-width) solid var(--border);
        font-size: 0.9375rem;
        font-weight: var(--primary-medium);
        color: var(--text);
        transition: color var(--hover-duration) var(--hover-ease);
        &:hover {
          color: var(--coral-500);
        }
      }
    }

    .body-article_text {
      font-size: 1.125rem;
      line-height: 1.7;
      & > h2 {
        margin: 3rem 0 0.75rem;
        font-size: clamp(1.625rem, 2.6vw, 2.125rem);
        font-weight: var(--primary-semibold);
        line-height: 1.15;
        letter-spacing: -0.025em;
        scroll-margin-top: calc(var(--nav-height) + 2rem);
      }
      & > p {
        margin-bottom: 1rem;
      }
      & > ul {
        margin-bottom: 1rem;
        padding-left: 1.375rem;
        list-style: disc;
        & li {
          margin-bottom: 0.375rem;
        }
      }
      & > blockquote {
        margin: 2rem 0;
        padding-left: 1.25rem;
        border-left: 0.1875rem solid var(--brand-500);
        font-size: clamp(1.375rem, 2vw, 1.625rem);
        font-weight: var(--primary-semibold);
        line-height: 1.35;
        letter-spacing: -0.017em;
      }
    }

    .body-article_summary {
      padding: 1.5rem 1.75rem;
      border-radius: var(--radius-main);
      background-color: var(--background-2);
      scroll-margin-top: calc(var(--nav-height) + 2rem);
      & p {
        margin-bottom: 0.5rem;
        font-size: 1rem;
        font-weight: var(--primary-semibold);
      }
      & ul {
        padding-left: 1.375rem;
        list-style: disc;
      }
      & li {
        margin-bottom: 0.375rem;
      }
    }

    .body-article_cta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem 1.5rem;
      margin-top: 2.5rem;
      padding: 1.5rem 1.75rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      font-size: 1rem;
      line-height: 1.5;
      & a {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        min-height: 2.75rem;
        font-weight: var(--primary-semibold);
        color: var(--text);
        & svg {
          transition: transform var(--hover-duration) var(--hover-ease);
        }
        &:hover svg {
          transform: translateX(0.25rem);
        }
      }
    }
  }
</style>
