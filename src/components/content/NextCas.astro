---
import Icon from "@/components/media/Icon.astro";
import arrowForward from "@/assets/icons/ion/arrow-forward-outline.svg";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Page of the next case study. */
  href: string;
  /** Sector and city of the next case study. */
  tag: string;
  /** Title of the next case study. */
  title: string;
  class?: string;
}

const { render = true, href, tag, title, class: className } = Astro.props;
---

{render && (
  <a class:list={["next-cas_wrap", className]} href={href}>
    <span class="next-cas_meta">
      <b>Cas suivant</b>
      <span>{tag}</span>
    </span>
    <span class="next-cas_title">{title}</span>
    <span class="next-cas_go" aria-hidden="true">
      <Icon src={arrowForward} variant="small" />
    </span>
  </a>
)}

<style is:global>
  @layer components {
    .next-cas_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 3.5rem;
      gap: 0.5rem 1.5rem;
      align-items: center;
      padding: 1.75rem 0;
      border-top: 0.09375rem solid var(--text);
      border-bottom: var(--border-width) solid var(--border);
      color: var(--text);
      &:hover .next-cas_go {
        background-color: var(--brand-500);
        box-shadow: none;
      }
    }

    .next-cas_meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem 1.125rem;
      font-size: 0.9375rem;
      color: var(--text-3);
      & b {
        font-weight: var(--primary-medium);
        color: var(--text);
      }
    }

    .next-cas_title {
      grid-column: 1;
      font-size: clamp(1.375rem, 2.4vw, 2rem);
      font-weight: var(--primary-semibold);
      line-height: 1.15;
      letter-spacing: -0.025em;
    }

    .next-cas_go {
      grid-column: 2;
      grid-row: 1 / 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 3.5rem;
      height: 3.5rem;
      border-radius: var(--radius-button);
      box-shadow: inset 0 0 0 0.09375rem var(--text);
      font-size: 1.25rem;
      transition: background-color var(--hover-duration) var(--hover-ease);
    }
  }
</style>
