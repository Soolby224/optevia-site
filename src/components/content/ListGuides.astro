---
import Icon from "@/components/media/Icon.astro";
import arrowRight from "@/assets/icons/arrow-right.svg";

const guides = [
  {
    slug: "fiche-google",
    title: "La fiche Google des artisans",
    text: "Tout régler, de la catégorie aux photos, pour sortir en premier sur Maps.",
    minutes: 20,
  },
  {
    slug: "referencement-local",
    title: "Être trouvé dans sa ville",
    text: "Le référencement local, étape par étape : pages, mots, annuaires.",
    minutes: 25,
  },
  {
    slug: "ia",
    title: "Être recommandé par les IA",
    text: "Ce que regardent ChatGPT, Gemini et Perplexity, et comment y apparaître.",
    minutes: 18,
  },
  {
    slug: "avis-clients",
    title: "Les avis clients",
    text: "En obtenir plus, y répondre, gérer les mauvais sans s’énerver.",
    minutes: 15,
  },
  {
    slug: "site-internet",
    title: "Le site qui fait appeler",
    text: "Les pages, les photos et les boutons qui transforment une visite en appel.",
    minutes: 22,
  },
];
---

<ol class="list-guides_wrap">
  {guides.map((guide, index) => (
    <li>
      <a class="list-guides_item" href={`/guides/${guide.slug}`}>
        <span class="list-guides_number">{String(index + 1).padStart(2, "0")}</span>
        <span class="list-guides_content">
          <strong>{guide.title}</strong>
          <span>{guide.text}</span>
        </span>
        <span class="list-guides_time">{guide.minutes} min</span>
        <span class="list-guides_go" aria-hidden="true">
          <Icon src={arrowRight} variant="small" />
        </span>
      </a>
    </li>
  ))}
</ol>

<style is:global>
  @layer components {
    .list-guides_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      border-top: var(--border-width) solid var(--border);
    }

    .list-guides_item {
      display: grid;
      grid-template-columns: 3.5rem minmax(0, 1fr) 5.625rem 3.25rem;
      gap: 1rem 2rem;
      align-items: center;
      padding: clamp(1.375rem, 2.6vw, 2rem) 0;
      border-bottom: var(--border-width) solid var(--border);
      color: var(--text);
      &:hover .list-guides_go {
        border-color: var(--brand-500);
        background-color: var(--brand-500);
      }
      @media (width < 43.75rem) {
        grid-template-columns: 2.5rem minmax(0, 1fr) 3.25rem;
        gap: 0.5rem 1rem;
      }
    }

    .list-guides_number {
      font-size: 0.9375rem;
      font-weight: var(--primary-semibold);
      color: var(--coral-500);
      font-variant-numeric: tabular-nums;
    }

    .list-guides_content {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      min-width: 0;
      & strong {
        font-size: clamp(1.5rem, 2.6vw, 2.25rem);
        font-weight: var(--primary-semibold);
        line-height: 1.1;
        letter-spacing: -0.03em;
      }
      & span {
        font-size: 1.0625rem;
        line-height: 1.5;
        color: var(--text-2);
      }
    }

    .list-guides_time {
      font-size: 0.9375rem;
      font-weight: var(--primary-medium);
      color: var(--text-3);
      @media (width < 43.75rem) {
        grid-column: 2;
        grid-row: 2;
      }
    }

    .list-guides_go {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 3.25rem;
      height: 3.25rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
      font-size: 1.125rem;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (width < 43.75rem) {
        grid-column: 3;
        grid-row: 1 / span 2;
      }
    }
  }
</style>
