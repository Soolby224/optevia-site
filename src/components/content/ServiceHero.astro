---
import Breadcrumb from "@/components/global/Breadcrumb.astro";
import PhotoSlot from "@/components/media/PhotoSlot.astro";
import type { ComponentProps } from "astro/types";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** SEO heading, small, above the tagline. */
  title: string;
  /** Text under the tagline. */
  text: string;
  /** Description of the hero photo. */
  photo: string;
  /** Trail from the home page to the current page. The last item is the current page. */
  breadcrumb: ComponentProps<typeof Breadcrumb>["items"];
  /** Label pinned on the photo. */
  label?: string;
  /** Id of the heading, referenced by the section's `aria-labelledby`. */
  id?: string;
  class?: string;
}

const {
  render = true,
  title,
  text,
  photo,
  breadcrumb,
  label,
  id = "service-hero-title",
  class: className,
} = Astro.props;
---

{render && (
  <div class:list={["service-hero_wrap", className]}>
    <div class="service-hero_content">
      <Breadcrumb items={breadcrumb} />
      <h1 id={id} class="service-hero_seo">{title}</h1>
      <p class="service-hero_tagline"><slot /></p>
      <p class="service-hero_text">{text}</p>
      <div class="service-hero_actions"><slot name="actions" /></div>
    </div>
    <div class="service-hero_visual">
      <PhotoSlot alt={photo} radius="small" eager />
      {label && <span class="service-hero_label">{label}</span>}
    </div>
  </div>
)}

<style is:global>
  @layer components {
    .service-hero_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 4.5rem);
      align-items: center;
      @media (width < 60rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .service-hero_content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .service-hero_seo {
      font-size: 0.9375rem;
      font-weight: var(--primary-medium);
      line-height: 1.4;
      letter-spacing: 0;
      color: var(--text-3);
      text-box: none;
    }

    .service-hero_tagline {
      font-size: clamp(2.5rem, 5.2vw, 4.75rem);
      font-weight: var(--primary-semibold);
      line-height: 1;
      letter-spacing: -0.038em;
      & strong,
      & span {
        font-weight: inherit;
        color: var(--coral-500);
      }
    }

    .service-hero_text {
      max-width: 33.75rem;
      font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
      line-height: 1.6;
      color: var(--text-2);
    }

    .service-hero_actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      @media (width < 45rem) {
        width: 100%;
        & > * {
          width: 100%;
        }
      }
    }

    .service-hero_visual {
      position: relative;
      justify-self: end;
      width: 100%;
      max-width: 36.25rem;
      aspect-ratio: 579 / 709;
      @media (width < 60rem) {
        max-width: none;
        aspect-ratio: 4 / 3;
      }
    }

    .service-hero_label {
      position: absolute;
      left: 1rem;
      bottom: 1rem;
      padding: 0.5rem 0.75rem;
      border-radius: var(--radius-button);
      background-color: var(--light-100);
      color: var(--dark-900);
      font-size: 0.875rem;
      font-weight: var(--primary-semibold);
    }
  }
</style>
