---
import PhotoSlot from "@/components/media/PhotoSlot.astro";
import Heading from "@/components/typography/Heading.astro";
import Icon from "@/components/media/Icon.astro";
import arrowRight from "@/assets/icons/ion/arrow-forward-outline.svg";

const testimonials = [
  {
    id: "renovation",
    sector: "Rénovation énergétique",
    quote: "Du premier audit à la mise en ligne, tout a été expliqué simplement. On sait enfin pourquoi nos clients nous trouvent.",
    label: ["Clairs, efficaces & toujours", "à l’écoute de nos besoins."],
  },
  {
    id: "plomberie",
    sector: "Plomberie",
    quote: "Des actions concrètes et des résultats qu’on voit chaque semaine sur notre fiche Google.",
    label: ["Enfin une agence qui parle", "comme nous, sans jargon."],
  },
  {
    id: "electricite",
    sector: "Électricité",
    quote: "L’audit nous a montré exactement ce qui clochait. Aujourd’hui, on est cités quand on demande un électricien à une IA.",
    label: ["Un score qui dit tout,", "dès le premier jour."],
  },
];
---

<div class="testimonials-home_wrap" data-testimonials>
  <Heading id="testimonials-home-title" class="heading-accent">
    Ce que disent<br /><strong>nos clients.</strong>
  </Heading>

  <div class="testimonials-home_layout">
    <div class="testimonials-home_portrait">
      {testimonials.map((item, index) => (
        <div class="testimonials-home_slide" data-index={index} hidden={index !== 0}>
          <div class="testimonials-home_person">
            <PhotoSlot alt={`Portrait du client (${item.sector})`} />
          </div>
          <p class="testimonials-home_label">
            <span>{item.label[0]}</span>
            <span>{item.label[1]}</span>
          </p>
        </div>
      ))}
    </div>

    <div class="testimonials-home_quote" aria-live="polite">
      {testimonials.map((item, index) => (
        <figure class="testimonials-home_slide" data-index={index} hidden={index !== 0}>
          <blockquote class="testimonials-home_text">
            « <span>[À remplacer]</span> {item.quote} »
          </blockquote>
          <figcaption class="testimonials-home_author">
            <strong>[Prénom Nom]</strong>
            <span>{item.sector} · [Ville]</span>
          </figcaption>
        </figure>
      ))}
      <div class="testimonials-home_arrows">
        <button class="testimonials-home_arrow is-back" type="button" data-step="-1" aria-label="Avis précédent">
          <Icon src={arrowRight} variant="small" />
        </button>
        <button class="testimonials-home_arrow" type="button" data-step="1" aria-label="Avis suivant">
          <Icon src={arrowRight} variant="small" />
        </button>
      </div>
    </div>

    <div class="testimonials-home_thumbs" aria-label="Choisir un avis">
      {testimonials.map((item, index) => (
        <button
          class="testimonials-home_thumb"
          type="button"
          data-goto={index}
          aria-label={`Voir l’avis : ${item.sector}`}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          <PhotoSlot tag="span" alt="" />
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-testimonials]").forEach((root) => {
    const slides = root.querySelectorAll<HTMLElement>(".testimonials-home_slide");
    const thumbs = root.querySelectorAll<HTMLButtonElement>("[data-goto]");
    const count = thumbs.length;
    let current = 0;

    const show = (index: number) => {
      current = (index + count) % count;
      slides.forEach((slide) => {
        slide.hidden = Number(slide.dataset.index) !== current;
      });
      thumbs.forEach((thumb) => {
        thumb.setAttribute("aria-pressed", String(Number(thumb.dataset.goto) === current));
      });
    };

    thumbs.forEach((thumb) =>
      thumb.addEventListener("click", () => show(Number(thumb.dataset.goto))),
    );
    root.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((button) =>
      button.addEventListener("click", () => show(current + Number(button.dataset.step))),
    );
  });
</script>

<style is:global>
  @layer components {
    .testimonials-home_wrap {
      width: 100%;
    }

    .testimonials-home_layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.62fr);
      gap: 1rem;
      margin-top: clamp(4.5rem, 8vw, 6.875rem);
      @media (width < 56.25rem) {
        grid-template-columns: minmax(0, 1fr);
        margin-top: 2.5rem;
      }
    }

    .testimonials-home_portrait {
      position: relative;
      min-height: clamp(18rem, 30vw, 30rem);
      border-radius: var(--radius-small);
      background-color: var(--light-200);
      @media (width < 56.25rem) {
        min-height: 21.25rem;
        margin-top: 3rem;
      }
    }

    .testimonials-home_slide[hidden] {
      display: none;
    }

    .testimonials-home_portrait .testimonials-home_slide {
      position: absolute;
      inset: 0;
    }

    .testimonials-home_person {
      position: absolute;
      inset: auto 4% 0;
      height: 115%;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      overflow: hidden;
      border-radius: 0 0 var(--radius-small) var(--radius-small);
      & svg {
        width: 100%;
        height: 100%;
      }
    }

    .testimonials-home_label {
      position: absolute;
      left: 0.5rem;
      bottom: 0.75rem;
      max-width: 92%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-box: none;
      & span {
        padding: 0.125rem 0.5rem;
        background-color: var(--light-100);
        font-weight: var(--primary-semibold);
        font-size: clamp(1rem, 1.3vw, 1.125rem);
        letter-spacing: -0.013em;
        line-height: 1.45;
      }
    }

    .testimonials-home_quote {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(1.75rem, 3vw, 2.75rem) clamp(1.5rem, 2.6vw, 2.25rem) 1.25rem;
      border-radius: var(--radius-small);
      background-color: var(--light-200);
      & .testimonials-home_slide:not([hidden]) {
        display: flex;
        flex-direction: column;
        gap: 1.125rem;
        flex: 1;
        justify-content: center;
      }
    }

    .testimonials-home_text {
      max-width: 40rem;
      font-weight: var(--primary-medium);
      font-size: clamp(1.25rem, 1.8vw, 1.5rem);
      line-height: 1.4;
      letter-spacing: -0.013em;
      & span {
        color: var(--coral-500);
      }
    }

    .testimonials-home_author {
      display: flex;
      flex-direction: column;
      font-size: 0.9375rem;
      line-height: 1.5;
      & strong {
        font-weight: var(--primary-semibold);
      }
      & span {
        font-size: 0.875rem;
        color: var(--text-2);
      }
    }

    .testimonials-home_arrows {
      display: flex;
      justify-content: flex-end;
      gap: 0.375rem;
      margin-top: 1.25rem;
    }

    .testimonials-home_arrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-button);
      background-color: var(--light-100);
      transition: background-color var(--hover-duration) var(--hover-ease);
      &.is-back .icon {
        rotate: 180deg;
      }
      &:hover {
        background-color: var(--brand-500);
        border-color: var(--brand-500);
      }
    }

    .testimonials-home_thumbs {
      grid-column: 2;
      display: flex;
      gap: 0.875rem;
      @media (width < 56.25rem) {
        grid-column: 1;
      }
    }

    .testimonials-home_thumb {
      width: 3rem;
      height: 3rem;
      overflow: hidden;
      border-radius: 0.25rem;
      background-color: var(--light-200);
      opacity: 0.35;
      transition: opacity 250ms var(--hover-ease);
      & svg {
        width: 100%;
        height: 100%;
      }
      &:hover {
        opacity: 0.7;
      }
      &[aria-pressed="true"] {
        opacity: 1;
      }
    }
  }
</style>
