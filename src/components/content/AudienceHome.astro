---
import PhotoSlot from "@/components/media/PhotoSlot.astro";
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import check from "@/assets/icons/check-square.svg";

const audiences = [
  {
    id: "artisan",
    tab: "Je suis artisan",
    eyebrow: "Indépendant ou petite équipe",
    title: "Artisan de l’habitat",
    text: "Vous intervenez chez les particuliers de votre secteur. On fait sonner votre téléphone avec des clients proches de chez vous.",
    needs: [
      "Une fiche Google qui sort en tête dans votre zone",
      "Des avis clients qui donnent envie d’appeler",
      "Un site simple qui transforme la visite en devis",
    ],
    chips: ["Plombier", "Électricien", "Chauffagiste", "Menuisier", "Couvreur"],
    cta: "Solutions pour artisans",
    href: "/artisans",
    photo: "Artisan seul en intervention chez un particulier",
    icon: "tool",
  },
  {
    id: "entreprise",
    tab: "Nous sommes une entreprise",
    eyebrow: "PME, multi-chantiers ou multi-agences",
    title: "Entreprise du BTP & de la rénovation",
    text: "Vous gérez des équipes et plusieurs zones. On structure votre visibilité ville par ville et on vous fait recommander par les IA.",
    needs: [
      "Une page et une fiche par ville ou par agence",
      "Être cité par ChatGPT, Gemini et Perplexity",
      "Un suivi clair de vos demandes de devis",
    ],
    chips: ["Rénovation énergétique", "Pompes à chaleur", "Gros œuvre", "Multi-agences"],
    cta: "Solutions pour entreprises",
    href: "/entreprises",
    photo: "Équipe sur un chantier de rénovation",
    icon: "building",
  },
];
---

<div class="audience-home_wrap">
  <div class="audience-home_head">
    <Heading id="audience-home-title" class="heading-accent">
      Vous êtes plutôt…<br /><strong>artisan ou entreprise ?</strong>
    </Heading>
    <p class="audience-home_lead">
      Même objectif, être vu et choisi. Mais un artisan seul et une entreprise
      du BTP n’ont pas les mêmes besoins : on adapte la méthode.
    </p>
  </div>

  <div class="audience-home_switch" role="radiogroup" aria-label="Votre profil">
    {audiences.map((audience, index) => (
      <label class="audience-home_tab">
        <input
          class="audience-home_radio"
          type="radio"
          name="audience-home"
          value={audience.id}
          checked={index === 0}
        />
        <svg viewBox="0 0 24 24" aria-hidden="true">
          {audience.icon === "tool" ? (
            <path d="M14.5 6.5a4 4 0 0 0-5.3 5.3L4 17v3h3l5.2-5.2a4 4 0 0 0 5.3-5.3l-2.6 2.6-2.4-.6-.6-2.4z" />
          ) : (
            <path d="M3 21h18M5 21V8l7-4 7 4v13M9 12h2M13 12h2M9 16h2M13 16h2" />
          )}
        </svg>
        {audience.tab}
      </label>
    ))}
  </div>

  <div class="audience-home_panels">
    {audiences.map((audience) => (
      <div class="audience-home_panel" data-audience={audience.id}>
        <div class="audience-home_text">
          <p class="audience-home_eyebrow">{audience.eyebrow}</p>
          <h3 class="audience-home_title">{audience.title}</h3>
          <p class="audience-home_body">{audience.text}</p>
          <ul class="audience-home_needs">
            {audience.needs.map((need) => (
              <li>
                <span class="audience-home_check">
                  <Icon src={check} variant="small" />
                </span>
                {need}
              </li>
            ))}
          </ul>
          <ul class="audience-home_chips" aria-label="Exemples">
            {audience.chips.map((chip) => <li>{chip}</li>)}
          </ul>
          <Button element="link" href={audience.href} arrow>
            {audience.cta}
          </Button>
        </div>
        <div class="audience-home_photo">
          <PhotoSlot alt={audience.photo} radius="small" />
        </div>
      </div>
    ))}
  </div>
</div>

<style is:global>
  @layer components {
    .audience-home_wrap {
      width: 100%;
    }

    .audience-home_head {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.125rem;
      text-align: center;
    }

    .audience-home_lead {
      max-width: 33.75rem;
      font-size: 1rem;
      line-height: 1.6;
      color: var(--text-2);
    }

    .audience-home_switch {
      display: flex;
      gap: 0.25rem;
      width: max-content;
      max-width: 100%;
      margin: clamp(2.25rem, 4vw, 3rem) auto 0;
      padding: 0.375rem;
      border: var(--border-width) solid var(--border);
      border-radius: 0.625rem;
      background-color: var(--light-200);
      @media (width < 37.5rem) {
        width: 100%;
      }
    }

    .audience-home_tab {
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      min-height: 3.25rem;
      padding: 0 1.375rem;
      border-radius: var(--radius-button);
      font-weight: var(--primary-semibold);
      font-size: 1rem;
      color: var(--text-2);
      white-space: nowrap;
      transition:
        background-color 250ms var(--hover-ease),
        color 250ms var(--hover-ease);
      & svg {
        width: 1.25rem;
        flex: none;
        fill: none;
        stroke: currentcolor;
        stroke-width: 1.6;
        stroke-linecap: square;
      }
      &:hover {
        color: var(--text);
      }
      &:has(:checked) {
        background-color: var(--dark-900);
        color: var(--light-100);
        & svg {
          color: var(--brand-500);
        }
      }
      &:has(:focus-visible) {
        outline: var(--focus-width) solid var(--dark-900);
        outline-offset: 0.1875rem;
      }
      @media (width < 37.5rem) {
        flex: 1;
        justify-content: center;
        padding: 0 0.625rem;
        font-size: 0.875rem;
        white-space: normal;
        text-align: center;
        line-height: 1.2;
        & svg {
          display: none;
        }
      }
    }

    .audience-home_radio {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .audience-home_panels {
      margin-top: clamp(1.75rem, 3vw, 2.5rem);
    }

    .audience-home_panel {
      display: none;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 1rem;
      align-items: stretch;
      @media (width < 56.25rem) {
        grid-template-columns: minmax(0, 1fr);
        & .audience-home_photo {
          order: -1;
        }
      }
    }

    .audience-home_wrap:has([value="artisan"]:checked) [data-audience="artisan"],
    .audience-home_wrap:has([value="entreprise"]:checked) [data-audience="entreprise"] {
      display: grid;
      animation: audience-home-in 450ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    @keyframes audience-home-in {
      from {
        opacity: 0;
        transform: translateY(0.625rem);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    .audience-home_text {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: clamp(1.75rem, 3.4vw, 3rem);
      border-radius: var(--radius-small);
      background-color: var(--light-200);
    }

    .audience-home_eyebrow {
      font-size: 0.875rem;
      font-weight: var(--primary-medium);
      color: var(--text-3);
    }

    .audience-home_title {
      font-size: clamp(1.875rem, 3vw, 2.75rem);
      line-height: 1.05;
      letter-spacing: -0.035em;
    }

    .audience-home_body {
      max-width: 28.75rem;
      font-size: 1rem;
      line-height: 1.6;
      color: var(--text-2);
    }

    .audience-home_needs {
      width: 100%;
      margin-top: 0.375rem;
      border-top: var(--border-width) solid var(--border);
      & li {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-height: 3.25rem;
        border-bottom: var(--border-width) solid var(--border);
        font-weight: var(--primary-medium);
        font-size: 1rem;
      }
    }

    .audience-home_check {
      flex: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      height: 1.75rem;
      border-radius: var(--radius-button);
      background-color: var(--brand-500);
      color: var(--dark-900);
    }

    .audience-home_chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
      & li {
        padding: 0.375rem 0.625rem;
        border: var(--border-width) solid var(--border);
        border-radius: 0.25rem;
        background-color: var(--light-100);
        font-size: 0.8125rem;
        font-weight: var(--primary-medium);
      }
    }

    .audience-home_photo {
      min-height: 32.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      border-radius: var(--radius-small);
      background-color: var(--light-300);
      font-size: 0.8125rem;
      color: var(--dark-500);
      text-align: center;
      @media (width < 56.25rem) {
        min-height: 0;
        aspect-ratio: 16 / 10;
      }
    }
  }
</style>
