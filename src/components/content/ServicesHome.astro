---
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";

const services = [
  {
    title: "Être choisi",
    accroche: "Qu’on vous trouve, et qu’on vous appelle.",
    text: "Quand quelqu’un cherche votre métier dans votre ville, sur Google ou en demandant à ChatGPT, c’est vous qui sortez. Et ce qu’il voit lui donne envie de vous appeler.",
    points: [
      "Un site qui donne confiance, avec votre logo",
      "Votre fiche Google, complète et à jour",
      "Sortir en premier dans votre ville",
      "Être conseillé par ChatGPT et les IA",
    ],
    photo: "Un artisan devant son camion, souriant, téléphone en main",
    icon: "home",
    href: "/etre-choisi",
    cta: "Découvrir Être choisi",
  },
  {
    title: "Gagner du temps et e‑réputation",
    accroche: "Plus un appel raté. Plus un devis oublié.",
    text: "Vos messages, vos demandes de devis et vos avis arrivent au même endroit. Les relances partent toutes seules, et vous restez sur vos chantiers.",
    points: [
      "Un SMS envoyé tout seul quand vous ratez un appel",
      "Vos devis relancés automatiquement",
      "Un avis demandé à chaque client satisfait",
      "Tous vos messages au même endroit",
    ],
    photo: "Un artisan sur un chantier qui consulte ses messages sur son téléphone",
    icon: "clock",
    href: "/gagner-du-temps",
    cta: "Découvrir Gagner du temps",
  },
];
---

<div class="services-home_wrap">
  <Heading id="services-home-title" class="heading-accent">
    Plus de clients.<br /><strong>Moins de temps perdu.</strong>
  </Heading>

  <div class="services-home_list">
    {services.map((service) => (
      <article class="services-home_card">
        <div
          class="services-home_photo"
          role="img"
          aria-label={`Emplacement image : ${service.photo}`}
        >
          <span class="services-home_tile" aria-hidden="true">
            {service.icon === "home" ? (
              <svg viewBox="0 0 24 24">
                <path d="M3.5 11L12 4l8.5 7M5.5 9.5V20h13V9.5" />
                <path d="M10 20v-5h4v5" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="8.5" />
                <path d="M12 7.5V12l3 2" />
              </svg>
            )}
          </span>
          <span class="services-home_photo_label">[Photo : {service.photo}]</span>
        </div>
        <h3 class="services-home_title">{service.title}</h3>
        <p class="services-home_accroche">{service.accroche}</p>
        <p class="services-home_text">{service.text}</p>
        <ul class="services-home_points">
          {service.points.map((point) => <li>{point}</li>)}
        </ul>
        <Button element="link" variant="link" href={service.href} arrow>
          {service.cta}
        </Button>
      </article>
    ))}
  </div>
</div>

<style is:global>
  @layer components {
    .services-home_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: clamp(2.5rem, 5vw, 4rem);
    }

    .services-home_list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      @media (width < 53.75rem) {
        grid-template-columns: minmax(0, 1fr);
        gap: 3.5rem;
      }
    }

    .services-home_card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.875rem;
      min-width: 0;
      &:hover .services-home_photo {
        transform: translateY(-0.25rem);
      }
    }

    .services-home_photo {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 10;
      display: flex;
      align-items: flex-end;
      padding: 1rem;
      border-radius: var(--radius-small);
      background-color: var(--light-300);
      transition: transform 300ms var(--hover-ease);
    }

    .services-home_photo_label {
      position: absolute;
      inset: 0.875rem 1rem auto;
      text-align: right;
      font-size: 0.75rem;
      line-height: 1.4;
      color: var(--dark-500);
    }

    .services-home_tile {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 3rem;
      height: 3rem;
      border-radius: var(--radius-main);
      background-color: var(--light-100);
      box-shadow: 0 0.25rem 0.75rem rgb(17 17 17 / 0.08);
      & svg {
        width: 1.5rem;
        fill: none;
        stroke: var(--dark-900);
        stroke-width: 1.6;
        stroke-linecap: square;
      }
    }

    .services-home_title {
      margin-top: 0.625rem;
      font-size: clamp(1.625rem, 2.4vw, 2rem);
      line-height: 1.1;
      letter-spacing: -0.025em;
    }

    .services-home_accroche {
      font-weight: var(--primary-medium);
      font-size: clamp(1.125rem, 1.6vw, 1.25rem);
      letter-spacing: -0.013em;
      line-height: 1.35;
    }

    .services-home_text {
      max-width: 32.5rem;
      font-size: 1rem;
      line-height: 1.6;
      color: var(--text-2);
    }

    .services-home_points {
      width: 100%;
      margin-top: 0.375rem;
      border-top: var(--border-width) solid var(--border);
      & li {
        position: relative;
        padding: 0.8125rem 0 0.8125rem 1.5rem;
        border-bottom: var(--border-width) solid var(--border);
        font-size: 1rem;
        line-height: 1.45;
        &::before {
          content: "";
          position: absolute;
          left: 0;
          top: 1.4375rem;
          width: 0.625rem;
          height: 0.125rem;
          background-color: currentcolor;
        }
      }
    }
  }
</style>
