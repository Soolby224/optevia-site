---
import Button from "@/components/Button.astro";
import HeroPage from "@/components/content/HeroPage.astro";
import type { FaqTheme } from "@/data/faq.ts";

interface Props {
  /** Themes listed under the intro, with their number of questions. */
  themes: FaqTheme[];
}

const { themes } = Astro.props;

const total = themes.reduce((sum, theme) => sum + theme.items.length, 0);
---

<div class="hero-faq_wrap">
  <HeroPage
    title="FAQ Optevia : site internet, référencement et automatisations pour artisans"
    lead={`${total} réponses claires sur nos services, nos prix et notre façon de travailler. Vous ne trouvez pas ? Posez-nous directement votre question.`}
    breadcrumb={[{ label: "Accueil", href: "/" }, { label: "FAQ" }]}
  >
    Une question ?<br /><span>On vous répond.</span>
    <ul slot="after" class="hero-faq_themes">
      {themes.map((theme) => (
        <li>
          <a href={`#${theme.id}`}>
            {theme.title}
            <span>{theme.items.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </HeroPage>

  {/* TODO : brancher un service de formulaire. Rien n’est envoyé pour l’instant. */}
  <form id="question" class="hero-faq_form" aria-labelledby="hero-faq-form-title" data-faq-form>
    <h2 id="hero-faq-form-title" class="hero-faq_form_title">Posez votre question</h2>
    <p class="hero-faq_form_lead">
      Une vraie personne vous répond, par téléphone ou par e‑mail, sous [délai
      à valider].
    </p>
    <div class="hero-faq_field">
      <label for="faq-first">Prénom</label>
      <input id="faq-first" name="prenom" type="text" autocomplete="given-name" placeholder="Votre prénom" required />
    </div>
    <div class="hero-faq_field">
      <label for="faq-contact">Téléphone ou e‑mail</label>
      <input id="faq-contact" name="contact" type="text" autocomplete="email" placeholder="Pour vous répondre" required />
    </div>
    <div class="hero-faq_field">
      <label for="faq-question">Votre question</label>
      <textarea id="faq-question" name="question" rows="4" placeholder="Ex. : mon site actuel peut-il servir pour la visibilité ?" required></textarea>
    </div>
    <Button type="submit" arrow>Envoyer ma question</Button>
    <p class="hero-faq_form_note" data-faq-note aria-live="polite">
      Vos coordonnées servent uniquement à vous répondre.
    </p>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-faq-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      // TODO : envoyer la question à un service de formulaire.
      const note = form.querySelector<HTMLElement>("[data-faq-note]");
      if (note) {
        note.textContent =
          "L’envoi en ligne n’est pas encore actif. Écrivez-nous sur WhatsApp ou réservez un appel depuis la page Contact.";
      }
    });
  });
</script>

<style is:global>
  @layer components {
    .hero-faq_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
      @media (width < 62.5rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .hero-faq_themes {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 31.25rem;
      margin-top: 0.75rem;
      border-top: var(--border-width) solid var(--border);
      & a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 3.25rem;
        border-bottom: var(--border-width) solid var(--border);
        font-size: 1.0625rem;
        font-weight: var(--primary-medium);
        color: var(--text);
        transition: color var(--hover-duration) var(--hover-ease);
        &:hover {
          color: var(--coral-500);
        }
      }
      & span {
        font-size: 0.875rem;
        color: var(--text-3);
        font-variant-numeric: tabular-nums;
      }
    }

    .hero-faq_form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: clamp(1.5rem, 3vw, 2.5rem);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      background-color: var(--light-200);
      scroll-margin-top: 6rem;
    }

    .hero-faq_form_title {
      font-size: clamp(1.625rem, 2.4vw, 2.125rem);
      line-height: 1.1;
      letter-spacing: -0.03em;
    }

    .hero-faq_form_lead {
      font-size: 1rem;
      line-height: 1.55;
      color: var(--text-2);
    }

    .hero-faq_field {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      & label {
        font-size: 0.875rem;
        font-weight: var(--primary-semibold);
      }
      & input,
      & textarea {
        width: 100%;
        min-height: 3rem;
        padding: 0.75rem 0.875rem;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-button);
        background-color: var(--light-100);
        font: inherit;
        font-size: 1rem;
        color: var(--text);
        &:focus-visible {
          border-color: var(--dark-900);
        }
      }
      & textarea {
        resize: vertical;
      }
    }

    .hero-faq_form_note {
      font-size: 0.8125rem;
      line-height: 1.5;
      color: var(--text-3);
    }
  }
</style>
