---
import Button from "@/components/Button.astro";

type Line = string | { label: string; offer: string };

type Offer = {
  id: string;
  title: string;
  lead: string;
  prefix?: string;
  price: string;
  unit: string;
  fee?: string;
  lines: Line[];
  note?: string;
  href: string;
};

const once: Offer = {
  id: "site",
  title: "Site internet",
  lead: "Un site qui donne confiance et fait appeler.",
  prefix: "dès",
  price: "597 €",
  unit: "une seule fois",
  lines: [
    "Logo et couleurs",
    "Pages services, zones et réalisations",
    "Formulaire de demande de devis",
    { label: "Nom de domaine", offer: "offert 1 an" },
    { label: "Hébergement", offer: "offert 1 an" },
    { label: "Maintenance du site", offer: "offerte 6 mois" },
    { label: "Formation pour gérer votre site", offer: "offerte" },
    "Le site vous appartient",
  ],
  href: "/etre-choisi",
};

const monthly: Offer[] = [
  {
    id: "visibilite",
    title: "Visibilité",
    lead: "Qu’on vous trouve dans votre ville.",
    prefix: "dès",
    price: "70 €",
    unit: "par mois",
    lines: [
      "Fiche Google optimisée et suivie",
      "Sortir en premier sur Google et Maps",
      "Être conseillé par ChatGPT et les IA",
      "Un compte rendu chaque mois",
    ],
    note: "Vous gardez votre site actuel si vous en avez un.",
    href: "/etre-choisi",
  },
  {
    id: "gagner-du-temps",
    title: "Gagner du temps avec optevia gestion",
    lead: "Plus un appel raté. Plus un devis oublié.",
    price: "150 €",
    unit: "par mois",
    fee: "+ 400 € de frais de mise en place, payés une seule fois",
    lines: [
      "SMS après chaque appel manqué",
      "Relance automatique des devis",
      "Demandes d’avis Google automatiques",
      "Tous vos messages dans une seule boîte",
    ],
    href: "/gagner-du-temps",
  },
];

const groups = [
  { label: "Payé une fois", offers: [once] },
  { label: "Chaque mois, sans engagement", offers: monthly, isMonthly: true },
];
---

<div class="pricing-tarifs_wrap">
  {groups.map((group) => (
    <div class:list={["pricing-tarifs_group", group.isMonthly && "is-monthly"]}>
      <p class="pricing-tarifs_label">
        <span class="pricing-tarifs_dot" aria-hidden="true" />
        {group.label}
      </p>
      <div class="pricing-tarifs_list">
        {group.offers.map((offer) => (
          <article id={offer.id} class="pricing-tarifs_card">
            <h3 class="pricing-tarifs_title">{offer.title}</h3>
            <p class="pricing-tarifs_lead">{offer.lead}</p>
            <p class="pricing-tarifs_price">
              {offer.prefix && <span>{offer.prefix}</span>}
              {offer.price}
              <small>{offer.unit}</small>
            </p>
            {offer.fee && <p class="pricing-tarifs_fee">{offer.fee}</p>}
            <ul class="pricing-tarifs_lines">
              {offer.lines.map((line) =>
                typeof line === "string" ? (
                  <li>{line}</li>
                ) : (
                  <li>{line.label} <em>{line.offer}</em></li>
                ),
              )}
            </ul>
            {offer.note && <p class="pricing-tarifs_note">{offer.note}</p>}
            <div class="pricing-tarifs_action">
              <Button element="link" href={offer.href} arrow>Voir le service</Button>
            </div>
          </article>
        ))}
      </div>
    </div>
  ))}
</div>

<style is:global>
  @layer components {
    .pricing-tarifs_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 1rem;
      align-items: stretch;
      @media (width < 62.5rem) {
        grid-template-columns: minmax(0, 1fr);
        gap: 2rem;
      }
    }

    .pricing-tarifs_group {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .pricing-tarifs_label {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      font-size: 0.9375rem;
      font-weight: var(--primary-semibold);
    }

    .pricing-tarifs_dot {
      width: 0.625rem;
      height: 0.625rem;
      border-radius: 50%;
      background-color: var(--brand-500);
      .is-monthly & {
        background-color: var(--coral-500);
      }
    }

    .pricing-tarifs_list {
      flex: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      .is-monthly & {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        @media (width < 43.75rem) {
          grid-template-columns: minmax(0, 1fr);
        }
      }
    }

    .pricing-tarifs_card {
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
      padding: clamp(1.5rem, 2.6vw, 2rem);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      background-color: var(--light-100);
      scroll-margin-top: 6rem;
      transition: border-color var(--hover-duration) var(--hover-ease);
      &:hover,
      &:target {
        border-color: var(--dark-900);
      }
    }

    .pricing-tarifs_title {
      font-size: clamp(1.375rem, 2vw, 1.625rem);
      line-height: 1.15;
      letter-spacing: -0.02em;
    }

    .pricing-tarifs_lead {
      font-size: 1rem;
      line-height: 1.5;
      color: var(--text-2);
    }

    .pricing-tarifs_price {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.5rem;
      margin-top: 0.5rem;
      font-size: clamp(2.5rem, 4vw, 3.5rem);
      font-weight: var(--primary-semibold);
      line-height: 1;
      letter-spacing: -0.045em;
      & span,
      & small {
        font-size: 0.9375rem;
        font-weight: var(--primary-medium);
        letter-spacing: 0;
        color: var(--text-3);
      }
    }

    .pricing-tarifs_fee {
      font-size: 0.875rem;
      font-weight: var(--primary-medium);
      color: var(--coral-500);
    }

    .pricing-tarifs_lines {
      display: flex;
      flex-direction: column;
      margin-top: 0.5rem;
      border-bottom: var(--border-width) solid var(--border);
      & li {
        padding: 0.75rem 0;
        border-top: var(--border-width) solid var(--border);
        font-size: 1rem;
        line-height: 1.4;
      }
      & em {
        display: inline-block;
        margin-left: 0.375rem;
        padding: 0.125rem 0.5rem;
        border-radius: 0.25rem;
        background-color: var(--brand-500);
        font-size: 0.8125rem;
        font-style: normal;
        font-weight: var(--primary-semibold);
      }
    }

    .pricing-tarifs_note {
      font-size: 0.875rem;
      line-height: 1.5;
      color: var(--text-3);
    }

    .pricing-tarifs_action {
      display: flex;
      flex-direction: column;
      margin-top: auto;
      padding-top: 0.75rem;
    }
  }
</style>
