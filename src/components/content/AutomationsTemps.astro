---
import Heading from "@/components/typography/Heading.astro";
import Icon from "@/components/media/Icon.astro";
import arrowRight from "@/assets/icons/arrow-right.svg";

type Automation = {
  when: string;
  then: string;
  label: string;
  sms?: string;
  review?: boolean;
  inbox?: { from: string; text: string }[];
};

const automations: Automation[] = [
  {
    when: "vous ratez un appel",
    then: "Un SMS part en moins d’une minute, avec un lien pour demander un devis.",
    label: "SMS envoyé automatiquement",
    sms: "Bonjour, je suis sur un chantier. Je vous rappelle avant midi. Pour un devis, c’est ici : [lien]",
  },
  {
    when: "une demande arrive (site, Google, Facebook)",
    then: "Réponse immédiate, et le client réserve lui-même un créneau dans votre agenda.",
    label: "SMS envoyé automatiquement",
    sms: "Merci pour votre demande. Choisissez votre créneau de visite : [lien agenda]",
  },
  {
    when: "un devis reste sans réponse",
    then: "Relance automatique à J + 2, puis à J + 7. Vous êtes prévenu quand il répond.",
    label: "SMS envoyé automatiquement",
    sms: "Avez-vous pu regarder notre devis ? Je reste disponible pour en parler.",
  },
  {
    when: "un chantier est terminé",
    then: "Le client reçoit automatiquement une demande d’avis Google, avec le lien direct.",
    label: "SMS envoyé automatiquement",
    sms: "Merci pour votre confiance. Un avis Google nous aiderait beaucoup : [lien]",
  },
  {
    when: "un client est déçu",
    then: "Il peut vous écrire avant de publier quoi que ce soit. Vous êtes prévenu tout de suite pour régler le problème.",
    label: "Votre avis sur le chantier",
    review: true,
  },
  {
    when: "vos messages arrivent de partout",
    then: "SMS, e-mails, WhatsApp, Facebook, Google : tout tombe dans une seule boîte, sur votre téléphone.",
    label: "Une seule boîte",
    inbox: [
      { from: "SMS", text: "Demande de devis, salle de bain" },
      { from: "WhatsApp", text: "Photos de la fuite" },
      { from: "Google", text: "Question sur vos horaires" },
      { from: "Facebook", text: "Disponible en mars ?" },
    ],
  },
];
---

<div class="automations-temps_wrap" data-automations>
  <div class="automations-temps_head">
    <Heading id="automations-temps-title" class="heading-accent">
      Ce qui tourne<br /><strong>tout seul.</strong>
    </Heading>
    <div class="automations-temps_nav">
      <p class="automations-temps_count" aria-live="polite">
        <span data-current>1</span> sur {automations.length}
      </p>
      <button type="button" class="automations-temps_arrow is-back" data-move="-1" aria-label="Précédent">
        <Icon src={arrowRight} variant="small" />
      </button>
      <button type="button" class="automations-temps_arrow" data-move="1" aria-label="Suivant">
        <Icon src={arrowRight} variant="small" />
      </button>
    </div>
  </div>

  <div class="automations-temps_view">
    <ol class="automations-temps_track" data-track>
      {automations.map((item, index) => (
        <li
          class:list={["automations-temps_card", index === 0 && "is-active"]}
          aria-hidden={index === 0 ? "false" : "true"}
          data-slide
        >
          <div class="automations-temps_content">
            <p class="automations-temps_when"><span>Quand</span>{item.when}</p>
            <p class="automations-temps_then"><span>Alors</span>{item.then}</p>
          </div>
          <div class="automations-temps_phone">
            <p class="automations-temps_phone_label">{item.label}</p>
            {item.sms && <p class="automations-temps_bubble">{item.sms}</p>}
            {item.review && (
              <>
                <p class="automations-temps_stars" role="img" aria-label="2 étoiles sur 5">
                  <span>★★</span>★★★
                </p>
                <p class="automations-temps_private">
                  <b>Dites-nous ce qui n’a pas été.</b>
                  L’artisan reçoit votre message tout de suite.
                </p>
                <p class="automations-temps_fake_input">Votre message…</p>
                <p class="automations-temps_google">Ou laisser un avis sur Google</p>
              </>
            )}
            {item.inbox && (
              <ul class="automations-temps_inbox">
                {item.inbox.map((message) => (
                  <li><b>{message.from}</b>{message.text}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>

  <div class="automations-temps_dots">
    {automations.map((_, index) => (
      <button
        type="button"
        class="automations-temps_dot"
        data-goto={index}
        aria-label={`Automatisation ${index + 1}`}
        aria-pressed={index === 0 ? "true" : "false"}
      />
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-automations]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-track]");
    const slides = root.querySelectorAll<HTMLElement>("[data-slide]");
    const dots = root.querySelectorAll<HTMLButtonElement>("[data-goto]");
    const current = root.querySelector<HTMLElement>("[data-current]");
    const count = slides.length;
    let index = 0;

    const show = (next: number) => {
      index = (next + count) % count;
      track?.style.setProperty("--_index", String(index));
      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === index);
        slide.setAttribute("aria-hidden", String(i !== index));
      });
      dots.forEach((dot, i) => dot.setAttribute("aria-pressed", String(i === index)));
      if (current) current.textContent = String(index + 1);
    };

    root.querySelectorAll<HTMLButtonElement>("[data-move]").forEach((button) => {
      button.addEventListener("click", () => show(index + Number(button.dataset.move)));
    });
    dots.forEach((dot) => dot.addEventListener("click", () => show(Number(dot.dataset.goto))));
    slides.forEach((slide, i) => slide.addEventListener("click", () => i !== index && show(i)));
  });
</script>

<style is:global>
  @layer components {
    .automations-temps_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: clamp(1.75rem, 4vw, 3rem);
    }

    .automations-temps_head {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1.25rem 3rem;
    }

    .automations-temps_nav {
      display: flex;
      align-items: center;
      gap: 0.625rem;
    }

    .automations-temps_count {
      margin-right: 0.5rem;
      font-size: 0.9375rem;
      font-weight: var(--primary-medium);
      color: var(--text-2);
      font-variant-numeric: tabular-nums;
    }

    .automations-temps_arrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 3.25rem;
      height: 3.25rem;
      border-radius: var(--radius-round);
      background-color: var(--dark-900);
      color: var(--light-100);
      font-size: 1.125rem;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
      &.is-back svg {
        transform: scaleX(-1);
      }
      &:hover {
        background-color: var(--brand-500);
        color: var(--dark-900);
      }
    }

    .automations-temps_view {
      --_w: min(100%, 56rem);
      --_gap: 1rem;
      overflow: clip;
      overflow-clip-margin: 0.5rem;
    }

    .automations-temps_track {
      display: flex;
      gap: var(--_gap);
      transform: translateX(calc(var(--_index, 0) * -1 * (var(--_w) + var(--_gap))));
      transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }
    }

    .automations-temps_card {
      flex: 0 0 var(--_w);
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: 1.5rem;
      align-items: center;
      min-height: 21.25rem;
      padding: clamp(1.5rem, 3vw, 2.5rem);
      border: var(--border-width) solid var(--sand-line);
      border-radius: var(--radius-large);
      background-color: var(--light-200);
      color: var(--dark-900);
      opacity: 0.45;
      transform: scale(0.97);
      cursor: pointer;
      transition:
        opacity 500ms var(--hover-ease),
        transform 500ms var(--hover-ease),
        background-color 500ms var(--hover-ease),
        color 500ms var(--hover-ease);
      &.is-active {
        border-color: var(--dark-900);
        background-color: var(--dark-900);
        color: var(--light-200);
        opacity: 1;
        transform: none;
        cursor: default;
        & .automations-temps_when span,
        & .automations-temps_then span {
          color: var(--brand-500);
        }
      }
      @media (width < 45rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .automations-temps_content {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .automations-temps_when,
    .automations-temps_then {
      & span {
        display: block;
        margin-bottom: 0.375rem;
        font-size: 0.8125rem;
        font-weight: var(--primary-semibold);
        letter-spacing: 0;
        color: var(--coral-500);
      }
    }

    .automations-temps_when {
      font-size: clamp(1.5rem, 2.6vw, 2.125rem);
      font-weight: var(--primary-semibold);
      line-height: 1.1;
      letter-spacing: -0.03em;
    }

    .automations-temps_then {
      font-size: 1.0625rem;
      line-height: 1.55;
    }

    .automations-temps_phone {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      padding: 1rem;
      border-radius: var(--radius-main);
      background-color: var(--light-100);
      color: var(--dark-900);
      box-shadow: 0 1.5rem 3rem -2rem rgb(17 17 17 / 0.35);
    }

    .automations-temps_phone_label {
      font-size: 0.75rem;
      font-weight: var(--primary-semibold);
      color: var(--dark-500);
    }

    .automations-temps_bubble {
      align-self: flex-start;
      max-width: 92%;
      padding: 0.75rem 0.875rem;
      border-radius: 1rem 1rem 1rem 0.25rem;
      background-color: var(--light-300);
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    .automations-temps_stars {
      font-size: 1.5rem;
      letter-spacing: 0.1em;
      color: var(--sand-line);
      & span {
        color: var(--brand-500);
      }
    }

    .automations-temps_private {
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--dark-700);
      & b {
        display: block;
        color: var(--dark-900);
      }
    }

    .automations-temps_fake_input {
      min-height: 3.5rem;
      padding: 0.625rem 0.75rem;
      border: var(--border-width) solid var(--sand-line);
      border-radius: var(--radius-button);
      font-size: 0.875rem;
      color: var(--dark-500);
    }

    .automations-temps_google {
      font-size: 0.8125rem;
      color: var(--dark-500);
      text-decoration: underline;
    }

    .automations-temps_inbox li {
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
      padding: 0.625rem 0;
      border-top: var(--border-width) solid var(--sand-line);
      font-size: 0.875rem;
      line-height: 1.4;
      color: var(--dark-700);
      & b {
        font-size: 0.75rem;
        color: var(--coral-500);
      }
    }

    .automations-temps_dots {
      display: flex;
      justify-content: center;
      gap: 0.25rem;
    }

    .automations-temps_dot {
      position: relative;
      width: 1.75rem;
      height: 2.75rem;
      &::before {
        content: "";
        position: absolute;
        inset: 50% 0.375rem auto;
        height: 0.25rem;
        border-radius: var(--radius-round);
        background-color: var(--border);
        transition: background-color var(--hover-duration) var(--hover-ease);
      }
      &[aria-pressed="true"]::before {
        background-color: var(--text);
      }
    }
  }
</style>
