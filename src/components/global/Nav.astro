---
import Icon from "@/components/media/Icon.astro";
import Button from "@/components/Button.astro";
import Logo from "@/components/global/Logo.astro";
import whatsapp from "@/assets/icons/whatsapp.svg";
import { SITE_NAME, CONTACT, NAV_LINKS } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
---

{render && (
  <header class:list={["nav_wrap", overlap && "overlap"]}>
    <div class="nav_inner theme-dark">
      <a class="nav_logo" href="/" aria-label={`${SITE_NAME}, accueil`}>
        <Logo />
      </a>
      <nav class="nav_menu" id="nav-menu" aria-label="Navigation principale">
        <ul class="nav_links">
          {NAV_LINKS.map((link) => (
            <li>
              <a class="nav_link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
          <li class="nav_mobile-only">
            <a class="nav_link" href={CONTACT.whatsapp} rel="noopener">
              Écrire sur WhatsApp
            </a>
          </li>
          <li class="nav_mobile-only">
            <a class="nav_link is-accent" href="/contact">
              Audit gratuit →
            </a>
          </li>
        </ul>
      </nav>
      <div class="nav_actions">
        <a
          class="nav_whatsapp"
          href={CONTACT.whatsapp}
          rel="noopener"
          aria-label="Nous écrire sur WhatsApp"
        >
          <Icon src={whatsapp} variant="medium" />
          <span class="nav_whatsapp_text">WhatsApp</span>
        </a>
        <Button
          element="link"
          href="/contact"
          size="small"
          arrow
          class="nav_cta"
        >
          Audit gratuit
        </Button>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path class="nav_toggle_bar" d="M4 8h16" />
            <path class="nav_toggle_bar" d="M4 16h10" />
            <circle class="nav_toggle_dot" cx="19.5" cy="16" r="2" />
          </svg>
        </button>
      </div>
    </div>
  </header>
)}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 60rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: relative;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding: 1rem var(--site-margin) 0;
      background-color: var(--light-100);

      &.overlap {
        position: absolute;
        inset-inline: 0;
        background-color: transparent;
      }
    }

    .nav_inner {
      position: relative;
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: var(--nav-height);
      padding: 0.625rem 0.625rem 0.625rem 1.375rem;
      border-radius: var(--radius-small);
    }

    .nav_logo {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }

    .nav_links {
      display: flex;
      align-items: center;
      gap: 1.875rem;
      font-size: 0.9375rem;
      font-weight: var(--primary-medium);
    }

    .nav_link {
      color: var(--light-200);
      opacity: 0.8;
      transition:
        opacity var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        opacity: 1;
      }
      @media (hover: hover) {
        &:hover {
          opacity: 1;
          color: var(--brand-500);
        }
      }
    }

    .nav_mobile-only {
      display: none;
    }

    .nav_actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav_whatsapp {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.875rem;
      padding: 0 0.875rem;
      border-radius: var(--radius-button);
      box-shadow: inset 0 0 0 0.0625rem
        color-mix(in srgb, var(--light-200) 28%, transparent);
      color: var(--light-200);
      font-weight: var(--primary-medium);
      font-size: 0.9375rem;
      white-space: nowrap;
      transition:
        box-shadow var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          box-shadow: inset 0 0 0 0.0625rem currentcolor;
          color: var(--brand-500);
        }
      }
    }

    .nav_toggle {
      display: none;
      align-items: center;
      justify-content: center;
      width: 2.875rem;
      height: 2.875rem;
      border-radius: var(--radius-button);
      background-color: var(--brand-500);
      & svg {
        fill: none;
        stroke: var(--dark-900);
        stroke-width: 1.6;
        stroke-linecap: square;
      }
      & .nav_toggle_dot {
        fill: var(--coral-400);
        stroke: none;
      }
    }

    @media (width < 60rem) {
      .nav_toggle {
        display: inline-flex;
      }

      .nav_menu {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        z-index: 20;
        width: min(86vw, 18.75rem);
        padding: 0.5rem;
        border-radius: var(--radius-small);
        background-color: var(--dark-900);
        visibility: hidden;
        opacity: 0;
        translate: 0 -0.5rem;
        transition:
          opacity var(--open-duration) var(--open-ease),
          translate var(--open-duration) var(--open-ease),
          visibility var(--open-duration) var(--open-ease);
      }

      .nav_wrap.open .nav_menu {
        visibility: visible;
        opacity: 1;
        translate: 0 0;
      }

      .nav_links {
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        font-size: 1.125rem;
        & > li + li {
          border-top: var(--border-width) solid var(--border);
        }
      }

      .nav_link {
        display: block;
        padding: 0.875rem;
        opacity: 1;
        &.is-accent {
          color: var(--brand-500);
          font-weight: var(--primary-semibold);
        }
      }

      .nav_mobile-only {
        display: block;
      }
    }

    @media (width < 32.5rem) {
      .nav_cta {
        display: none;
      }

      .nav_whatsapp {
        width: 2.875rem;
        padding: 0;
        justify-content: center;
      }

      .nav_whatsapp_text {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
      }
    }
  }
</style>
