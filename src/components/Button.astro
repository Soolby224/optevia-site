---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import close from "@/assets/icons/close.svg";
import play from "@/assets/icons/play.svg";
import pause from "@/assets/icons/pause.svg";
import arrowRight from "@/assets/icons/arrow-right.svg";
import { slotContent } from "@/utils/slots.ts";

type Emphasis = "primary" | "secondary";

type Tag =
  | (HTMLAttributes<"button"> & {
      /** Rendered element. */
      element?: "button";
      /** Native button type. */
      type?: "button" | "submit" | "reset";
      /** Disable the button. */
      disabled?: boolean;
      href?: never;
    })
  | (Omit<HTMLAttributes<"a">, "type"> & {
      element: "link";
      /** Link destination. */
      href?: string;
      type?: never;
      disabled?: never;
    });

type Kind =
  | {
      /** Button type. */
      variant?: "main";
      /** Visual emphasis. */
      emphasis?: Emphasis;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "link";
      /** A link carries no weight of its own: it is already the quietest. */
      emphasis?: never;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "play";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Play` or `Pause`. */
      label?: string;
      /** Show the pause icon and pressed state. */
      pressed?: boolean;
      direction?: never;
    }
  | {
      variant: "close";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Close`. */
      label?: string;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "arrow";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Next` or `Previous`. */
      label?: string;
      pressed?: never;
      /** Arrow direction. */
      direction?: "forward" | "back";
    };

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Button size. */
  size?: "main" | "small";
  /** Trailing arrow after the text (main and link variants). */
  arrow?: boolean;
} & Tag &
  Kind;

type AllProps = HTMLAttributes<"button"> &
  Omit<HTMLAttributes<"a">, "type"> & {
    render?: boolean;
    size?: "main" | "small";
    arrow?: boolean;
    variant?: "main" | "link" | "play" | "close" | "arrow";
    emphasis?: Emphasis;
    label?: string;
    pressed?: boolean;
    direction?: "forward" | "back";
    element?: "button" | "link";
    href?: string;
    type?: "button" | "submit" | "reset";
  };

const {
  render = true,
  size = "main",
  arrow: hasArrow = false,
  variant = "main",
  emphasis = "primary",
  label,
  pressed = false,
  direction = "forward",
  element = "button",
  href,
  type = "button",
  class: className,
  ...rest
} = Astro.props as AllProps;

const isLink = element === "link";
const Tag = isLink ? "a" : "button";
const tagAttrs = isLink
  ? { href: href || "#" }
  : { type: type === "submit" ? undefined : type };

const marks = { play, close, arrow };
/* main and link are written, the rest are marks with a label. */
const isWritten = variant === "main" || variant === "link";
const content = isWritten ? await slotContent(Astro.slots) : "";

const named = {
  play: pressed ? "Pause" : "Play",
  close: "Close",
  arrow: direction === "back" ? "Previous" : "Next",
};
---

{render && (isWritten ? content : true) && (
  <Tag
    class:list={[
      "button_wrap",
      emphasis !== "primary" && emphasis,
      variant !== "main" && variant,
      size !== "main" && size,
      isWritten && hasArrow && "has-arrow",
      variant === "arrow" && direction === "back" && "back",
      className,
    ]}
    aria-label={isWritten ? undefined : (label ?? named[variant])}
    aria-pressed={variant === "play" ? pressed : undefined}
    {...tagAttrs}
    {...rest}
  >
    {isWritten && (
      <span class="button_text text-style-trim">
        <Fragment set:html={content} />
      </span>
    )}
    {isWritten && hasArrow && (
      <span class="button_trail">
        <Icon class="button_trail_icon" src={arrowRight} variant="medium" />
      </span>
    )}
    {variant === "play" && (
      <Fragment>
        <Icon class="button_mark button_play" src={play} variant="small" />
        <Icon class="button_mark button_pause" src={pause} variant="small" />
      </Fragment>
    )}
    {variant === "close" && (
      <Icon class="button_mark" src={marks.close} variant="small" />
    )}
    {variant === "arrow" && (
      <Icon class="button_mark" src={marks.arrow} variant="small" />
    )}
  </Tag>
)}

<style is:global>
  @layer components {
    .button_wrap {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 0.5em;
      min-height: 3.75rem;
      padding: 0 1.5rem 0 1.75rem;
      background-color: var(--button-background);
      color: var(--button-text);
      border: 0.09375rem solid var(--button-border);
      border-radius: var(--radius-button);
      font-size: 1.125rem;
      font-weight: var(--primary-semibold);
      letter-spacing: -0.009em;
      line-height: 1.2;
      text-decoration: none;
      text-align: center;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover:not(:disabled) {
          background-color: var(--button-background-hover);
          color: var(--button-text-hover);
          border-color: var(--button-border-hover);
        }
      }
      &.small {
        min-height: 2.875rem;
        padding: 0 1rem 0 1.25rem;
        font-size: 0.9375rem;
      }
      &.has-arrow {
        justify-content: space-between;
        gap: 2.5rem;
        &.small {
          gap: 1.5rem;
        }
      }
      &:active:not(:disabled) {
        transform: translateY(0.0625rem);
      }
      &.secondary {
        --button-background: var(--button-2-background);
        --button-text: var(--button-2-text);
        --button-border: var(--button-2-border);
        --button-background-hover: var(--button-2-background-hover);
        --button-text-hover: var(--button-2-text-hover);
        --button-border-hover: var(--button-2-border-hover);
      }
      &.link {
        --button-background: transparent;
        --button-text: var(--link-text);
        --button-border: var(--link-border);
        --button-background-hover: transparent;
        --button-text-hover: var(--link-text-hover);
        --button-border-hover: var(--link-border);

        min-height: 0;
        padding: 0.4em 0;
        border: 0;
        border-bottom: var(--border-width) solid var(--button-border);
        border-radius: 0;
        background-image: linear-gradient(
          var(--link-border-hover),
          var(--link-border-hover)
        );
        background-repeat: no-repeat;
        background-origin: border-box;
        background-position: 100% 100%;
        background-size: 0 var(--border-width);
        transition:
          background-size calc(var(--hover-duration) * 2) var(--hover-ease),
          color var(--hover-duration) var(--hover-ease),
          border-color var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:hover:not(:disabled) {
            background-position: 0 100%;
            background-size: 100% var(--border-width);
          }
        }
      }
      &:is(.play, .close, .arrow) {
        gap: 0;
        padding: 0.75em;
        border-radius: var(--radius-round);
      }
      &.back .button_mark {
        rotate: 180deg;
      }
      &.play .button_pause {
        display: none;
      }
      &.play[aria-pressed="true"] {
        & .button_play {
          display: none;
        }
        & .button_pause {
          display: block;
        }
      }
      &:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }
      &.link.has-arrow {
        justify-content: flex-start;
        gap: 0.625rem;
        min-height: 3rem;
        border-bottom-width: 0.125rem;
        border-color: currentcolor;
        font-size: 1.0625rem;
      }
    }

    /* Trailing arrow: leaves on the right, comes back from the left. */
    .button_trail {
      display: inline-flex;
      overflow: hidden;
    }
    @keyframes button-arrow {
      0% { transform: translateX(0); opacity: 1; }
      38% { transform: translateX(1.125rem); opacity: 0; }
      39% { transform: translateX(-1.125rem); opacity: 0; }
      100% { transform: translateX(0); opacity: 1; }
    }
    @media (hover: hover) {
      .button_wrap:hover .button_trail_icon {
        animation: button-arrow 600ms cubic-bezier(0.6, 0, 0.2, 1);
      }
    }
    .button_wrap:focus-visible .button_trail_icon {
      animation: button-arrow 600ms cubic-bezier(0.6, 0, 0.2, 1);
    }
  }
</style>
