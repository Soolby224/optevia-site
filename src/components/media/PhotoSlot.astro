---
import Img from "@/components/media/Img.astro";
import placeholder from "@/assets/images/placeholder.svg";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Alt text describing the photo. */
  alt: string;
  /** Image source. Defaults to the placeholder until the real photo exists. */
  src?: ImageMetadata | string;
  /** Rendered element. Use `span` inside a button or other phrasing content. */
  tag?: "div" | "span";
  /** Shape: fill the parent, or a wide banner with its own ratio. */
  ratio?: "fill" | "wide";
  /** Corner radius. */
  radius?: "none" | "button" | "small" | "main" | "large";
  /** Load the image immediately instead of lazily. */
  eager?: boolean;
  class?: string;
}

const {
  render = true,
  alt,
  src = placeholder,
  tag: Tag = "div",
  ratio = "fill",
  radius = "none",
  eager = false,
  class: className,
} = Astro.props;
---

{render && (
  <Tag class:list={["photo-slot_wrap", ratio !== "fill" && ratio, radius !== "none" && `is-${radius}`, className]}>
    <Img
      src={src}
      alt={alt}
      class="cover-absolute"
      loading={eager ? "eager" : "lazy"}
      fetchPriority={eager ? "high" : "auto"}
    />
  </Tag>
)}

<style is:global>
  @layer components {
    .photo-slot_wrap {
      position: relative;
      display: block;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--background-3);
      &.wide {
        height: auto;
        aspect-ratio: 21 / 9;
        @media (width < 48rem) {
          aspect-ratio: 16 / 10;
        }
      }
      &.is-button {
        border-radius: var(--radius-button);
      }
      &.is-small {
        border-radius: var(--radius-small);
      }
      &.is-main {
        border-radius: var(--radius-main);
      }
      &.is-large {
        border-radius: var(--radius-large);
      }
      & img {
        object-fit: cover;
      }
    }
  }
</style>
